---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';

const waMessage = encodeURIComponent('Hola, me interesa el servicio de Preparación de Oposiciones. ¿Podéis informarme?');

const benefits = [
  { icon: 'ph-arrows-clockwise', title: 'Acompañamiento personalizado 360º', desc: 'Tutorización individual con un plan de estudio diseñado a tu medida, seguimiento semanal y revisión continua de tus progresos. No estudias solo: tienes a alguien que te marca el ritmo, te corrige y te empuja.' },
  { icon: 'ph-users-three', title: 'Equipo con experiencia real', desc: 'Preparadores, funcionarios en activo y miembros de tribunal. Criterios actualizados y enfoque eminentemente práctico. Sabrás exactamente qué buscan los tribunales… porque te lo cuentan quienes han estado en ellos.' },
  { icon: 'ph-books', title: 'Materiales y metodología probada', desc: 'Temarios estructurados, resúmenes, mapas mentales, plantillas, rúbricas y técnicas de estudio activas. Nada de leer y subrayar: aprenderás a estudiar de manera eficiente, reteniendo más en menos tiempo.' },
  { icon: 'ph-target', title: 'Simulacros y correcciones exhaustivas', desc: 'Tests, casos prácticos y exposiciones orales con feedback detallado y rúbricas idénticas a las del tribunal. Llegarás al examen con la oposición ya entrenada decenas de veces.' },
  { icon: 'ph-laptop', title: '100% online, 100% flexible', desc: 'Estudia desde donde quieras, cuando quieras, sin desplazamientos, sin horarios rígidos. Compatible con tu trabajo, tu familia y tu vida real.' },
];

const profiles = [
  { icon: 'ph-plant', title: 'Aspirantes que empiezan desde cero', desc: 'Aún no has elegido oposición o no sabes por dónde empezar. Te damos orientación inicial, te ayudamos a elegir el proceso que mejor encaja contigo y diseñamos tu plan de estudio de partida.' },
  { icon: 'ph-trend-up', title: 'Opositores en marcha que buscan mejorar', desc: 'Ya estudias, pero sientes que te falta método, constancia o un feedback experto que te haga subir nota. Te aportamos el rigor y la corrección que tu preparación necesita.' },
  { icon: 'ph-scales', title: 'Quienes compaginan trabajo, familia y oposición', desc: 'Tienes poco tiempo y no puedes permitirte desperdiciarlo. Te diseñamos un plan optimizado, con materiales claros y tutorización flexible que se adapta a tu agenda real.' },
  { icon: 'ph-rocket-launch', title: 'Opositores que se presentan en la próxima convocatoria', desc: 'La cuenta atrás ya empezó. Intensivos, simulacros, corrección de casos prácticos y supuestos, preparación de orales y defensa de programación. Llegarás listo.' },
  { icon: 'ph-arrow-counter-clockwise', title: 'Quienes ya han suspendido y quieren un enfoque nuevo', desc: 'Te quedaste cerca, pero te quedaste fuera. Hacemos un diagnóstico real de qué falló, diseñamos un plan de mejora y trabajamos los puntos exactos que te separan del aprobado.' },
];

const steps = [
  { n:'1', title:'Reservas tu plaza', desc:'Aseguras tu sitio en el programa. Las plazas son limitadas porque la tutorización es individual.' },
  { n:'2', title:'Sesión de diagnóstico inicial', desc:'Analizamos tu situación: oposición elegida, nivel actual, tiempo disponible, fortalezas, puntos débiles e historial previo.' },
  { n:'3', title:'Diseñamos tu plan personalizado', desc:'Recibirás una hoja de ruta clara, semana a semana, con objetivos, materiales y plazos realistas.' },
  { n:'4', title:'Tutorización y acompañamiento continuos', desc:'Tu tutor revisa tus avances, resuelve dudas, corrige casos prácticos y te marca el ritmo. No te dejamos nunca solo.' },
  { n:'5', title:'Simulacros con corrección de tribunal', desc:'Prácticas en condiciones reales: tipo test, supuestos, casos prácticos, exposiciones orales… todo con feedback detallado.' },
  { n:'6', title:'Preparación final intensiva', desc:'Llegas a la convocatoria con todo el temario dominado, simulacros entrenados y la confianza de quien sabe que ha hecho los deberes.' },
];

const faq = [
  { q:'¿Para qué oposiciones preparáis?', a:'Tenemos un enfoque generalista. Preparamos cualquier oposición: cuerpos docentes (Infantil, Primaria, Secundaria, FP), administraciones públicas, ámbito sanitario, justicia, fuerzas y cuerpos de seguridad, y otros procesos selectivos. En la sesión de diagnóstico inicial valoramos tu caso y te confirmamos el encaje exacto.' },
  { q:'¿La preparación es 100% online?', a:'Sí. Todo el servicio se desarrolla online, lo que te permite preparar tu oposición desde cualquier lugar de España y adaptar el estudio a tu agenda. Sin desplazamientos, sin horarios rígidos.' },
  { q:'¿Cuánto tiempo de dedicación necesito al día?', a:'Depende de tu oposición y del tiempo que te quede hasta la convocatoria. Por eso la primera sesión es de diagnóstico: diseñamos un plan realista en función de las horas reales que puedes dedicar, no de las que "deberías".' },
  { q:'¿Y si compagino el estudio con trabajo o familia?', a:'Es uno de los perfiles más habituales en nuestro programa. La tutorización es flexible, los materiales están disponibles 24/7 y el plan de estudio se adapta al tiempo real que tienes. Aprovecharás cada minuto.' },
  { q:'¿Qué pasa si ya me he presentado y suspendí?', a:'Empezamos con un diagnóstico de qué falló: temario, técnica, gestión del tiempo, exposición oral, casos prácticos… A partir de ahí, diseñamos un plan de mejora centrado exactamente en los puntos que te separan del aprobado.' },
  { q:'¿Tengo un tutor asignado o cambio de profesor?', a:'Tienes un tutor de referencia que te conoce, sigue tu progreso y conoce tu oposición. Eso permite un acompañamiento real, no genérico.' },
  { q:'¿Cómo son los simulacros?', a:'Reproducen las condiciones del examen real: tipo test, casos prácticos, supuestos, exposiciones orales y defensa de programación (cuando aplica). Recibes corrección detallada con rúbricas idénticas a las que utilizan los tribunales.' },
  { q:'¿Cómo reservo mi plaza?', a:'Pulsa el botón "Reserva tu plaza" y nos pondremos en contacto contigo para la sesión de diagnóstico inicial y confirmar tu incorporación al programa.' },
];

const compare = [
  { feat:'Tutorización',    other:'Grupos masivos, dudas sin resolver',  ours:'Individual y personalizada' },
  { feat:'Plan de estudio', other:'Igual para todos',                    ours:'Diseñado a tu medida' },
  { feat:'Equipo',          other:'Profesores teóricos',                 ours:'Docentes en activo, preparadores y funcionarios' },
  { feat:'Materiales',      other:'Temarios genéricos',                  ours:'Temarios + mapas mentales + plantillas + rúbricas' },
  { feat:'Correcciones',    other:'Genéricas o inexistentes',            ours:'Detalladas y con criterio de tribunal' },
  { feat:'Flexibilidad',    other:'Horarios cerrados',                   ours:'100% online, a tu ritmo' },
  { feat:'Seguimiento',     other:'Te dejan a tu suerte',                ours:'Revisión continua de progresos' },
];
---

<BaseLayout
  title="Preparación de Oposiciones — EducaVocación"
  description="Acompañamiento, tutorización y preparación 100% personalizada para que apruebes en la próxima convocatoria. Equipo de docentes en activo, preparadores y funcionarios."
  waMessage={waMessage}
  showWhatsApp={true}
>

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="section section--navy prep-hero">
    <div class="prep-blob prep-blob-1"></div>
    <div class="prep-blob prep-blob-2"></div>
    <div class="container prep-hero-inner fade-in">
      <a href="/#servicios" class="back-link"><i class="ph ph-arrow-left"></i> Servicios</a>
      <span class="tag">Preparación de oposiciones</span>
      <h1 class="h1" style="color:var(--white); margin-bottom:20px;">
        Prepara tu oposición con<br><em style="font-style:normal; color:var(--sky);">quien ya lo ha logrado</em>
      </h1>
      <p class="lead lead--white" style="max-width:600px;">
        Acompañamiento, tutorización y preparación 100% personalizada para que apruebes en la próxima convocatoria. Olvídate de estudiar a ciegas, perderte entre temarios infinitos o repetir errores que ya cometiste.
      </p>
      <div class="hero-trust">
        <span class="trust-pill"><i class="ph ph-check-circle"></i> 100% online</span>
        <span class="trust-pill"><i class="ph ph-check-circle"></i> Plan de estudio a medida</span>
        <span class="trust-pill"><i class="ph ph-check-circle"></i> Simulacros con feedback de tribunal</span>
        <span class="trust-pill"><i class="ph ph-check-circle"></i> Plazas limitadas</span>
      </div>
      <a href="#contacto" class="btn btn--sky btn--lg">
        Reserva tu plaza →
      </a>
    </div>
  </section>

  <!-- ── EL PROBLEMA ───────────────────────────────────────────────────── -->
  <section class="section section--cream">
    <div class="container">
      <div class="fade-in" style="max-width:640px; margin-bottom:48px;">
        <span class="tag tag--navy">El problema</span>
        <h2 class="h2">Estudiar mucho no es estudiar bien. Y tú ya lo sabes.</h2>
        <p class="lead">Cada año miles de opositores invierten cientos de horas y se quedan a las puertas. No por falta de capacidad. Por falta de método.</p>
      </div>
      <div class="pain-grid fade-in fade-delay-1">
        <div class="pain-card"><i class="ph ph-smiley-sad pain-icon"></i><p>Estudias muchas horas pero no avanzas al ritmo que esperabas.</p></div>
        <div class="pain-card"><i class="ph ph-brain pain-icon"></i><p>Te abruma la cantidad de temario y no sabes por dónde empezar.</p></div>
        <div class="pain-card"><i class="ph ph-question pain-icon"></i><p>Ya te has presentado y no sabes exactamente qué falló.</p></div>
        <div class="pain-card"><i class="ph ph-clock pain-icon"></i><p>Compaginas trabajo o familia y necesitas aprovechar cada minuto.</p></div>
        <div class="pain-card"><i class="ph ph-pencil pain-icon"></i><p>Llevas meses estudiando solo y necesitas que alguien te corrija con criterio real de tribunal.</p></div>
        <div class="pain-card"><i class="ph ph-target pain-icon"></i><p>Quieres llegar a la próxima convocatoria con la certeza de que estás preparado, no con la esperanza.</p></div>
      </div>
      <p class="conclusion-text fade-in fade-delay-2">
        La diferencia entre el opositor que aprueba y el que se queda fuera no suele ser el tiempo de estudio. Es tener <strong>un plan, un método y a alguien que ya conoce el terreno guiándote.</strong>
      </p>
    </div>
  </section>

  <!-- ── LA SOLUCIÓN ───────────────────────────────────────────────────── -->
  <section class="section section--white">
    <div class="container section-two-col">
      <div class="fade-in">
        <span class="tag">La solución</span>
        <h2 class="h2">Un servicio de preparación pensado para opositores que no se conforman con "intentarlo".</h2>
        <p class="lead">Te ofrecemos acompañamiento, preparación y tutorización personalizada adaptada a tu situación, a tu nivel y al tiempo real que tienes para estudiar.</p>
        <p class="lead" style="margin-top:12px;">Sea cual sea tu oposición —cuerpos docentes, administraciones públicas, ámbito sanitario, justicia, fuerzas y cuerpos de seguridad— te ayudamos a construir tu camino al aprobado con un enfoque hecho a medida.</p>
        <a href="#contacto" class="btn btn--primary" style="margin-top:28px;">Reserva tu plaza →</a>
      </div>
      <div class="solution-visual fade-in fade-delay-1">
        <div class="team-list">
          <div class="team-item"><i class="ph ph-chalkboard-teacher"></i><div><strong>Docentes en activo</strong><p>En diferentes etapas educativas, conocen las pruebas porque las ven todos los días.</p></div></div>
          <div class="team-item"><i class="ph ph-medal"></i><div><strong>Preparadores de oposiciones</strong><p>Con recorrido contrastado y resultados demostrables.</p></div></div>
          <div class="team-item"><i class="ph ph-bank"></i><div><strong>Funcionariado y AAPP</strong><p>Que ya superó el proceso y sabe exactamente qué se valora y qué penaliza.</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── BENEFICIOS ────────────────────────────────────────────────────── -->
  <section class="section section--light">
    <div class="container">
      <span class="tag fade-in">Qué te llevas</span>
      <h2 class="h2 fade-in fade-delay-1">Lo que obtienes cuando entras al programa</h2>
      <div class="benefits-grid">
        {benefits.map((b, i) => (
          <div class={`benefit-card fade-in fade-delay-${Math.min(i+1,3)}`}>
            <div class="benefit-icon"><i class={`ph ${b.icon}`}></i></div>
            <h3 class="h3">{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── A QUIÉN VA DIRIGIDO ───────────────────────────────────────────── -->
  <section class="section section--white">
    <div class="container">
      <span class="tag fade-in">Destinatarios</span>
      <h2 class="h2 fade-in fade-delay-1">Da igual en qué punto estés. Hay un plan para ti.</h2>
      <div class="profiles-grid fade-in fade-delay-2">
        {profiles.map(p => (
          <div class="profile-card-serv">
            <div class="profile-icon-serv"><i class={`ph ${p.icon}`}></i></div>
            <div>
              <strong>{p.title}</strong>
              <p>{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center; margin-top:48px;" class="fade-in">
        <a href="#contacto" class="btn btn--primary btn--lg">Reserva tu plaza →</a>
      </div>
    </div>
  </section>

  <!-- ── CÓMO TRABAJAMOS ───────────────────────────────────────────────── -->
  <section class="section section--cream">
    <div class="container">
      <span class="tag fade-in">El proceso</span>
      <h2 class="h2 fade-in fade-delay-1">Tu camino al aprobado, paso a paso</h2>
      <div class="steps-grid fade-in fade-delay-2">
        {steps.map(s => (
          <div class="step-card">
            <div class="step-num">{s.n}</div>
            <div>
              <h3 class="h3">{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── COMPARATIVA ───────────────────────────────────────────────────── -->
  <section class="compare-section">
    <div class="compare-glow compare-glow-1"></div>
    <div class="compare-glow compare-glow-2"></div>
    <div class="container">
      <span class="tag fade-in" style="background:rgba(41,171,226,.15);color:var(--sky);">Por qué elegirnos</span>
      <h2 class="h2 fade-in fade-delay-1" style="color:var(--white);">Lo que nos diferencia de otras academias</h2>
      <div class="glass-compare fade-in fade-delay-2">

        <!-- Desktop: dos paneles glass -->
        <div class="gcp-wrap">
          <div class="glass-panel glass-panel--other">
            <div class="glass-panel-header">
              <span class="panel-label panel-label--other"><i class="ph ph-x-circle"></i> Otros</span>
            </div>
            <ul class="glass-list">
              {compare.map(row => (
                <li>
                  <span class="feat-label">{row.feat}</span>
                  <span class="feat-val feat-val--other"><i class="ph ph-x-circle fv-icon"></i>{row.other}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="glass-panel glass-panel--ours">
            <div class="glass-shine"></div>
            <div class="glass-panel-header">
              <span class="panel-label panel-label--ours"><i class="ph ph-seal-check"></i> Nuestro servicio</span>
            </div>
            <ul class="glass-list">
              {compare.map(row => (
                <li>
                  <span class="feat-label">{row.feat}</span>
                  <span class="feat-val feat-val--ours"><i class="ph ph-check-circle fv-icon"></i>{row.ours}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Mobile: tabla 3 columnas -->
        <div class="gtable-mobile">
          <div class="gtable-head">
            <div class="gt-h gt-h--feat"></div>
            <div class="gt-h gt-h--other"><i class="ph ph-x-circle"></i> Otros</div>
            <div class="gt-h gt-h--ours"><i class="ph ph-seal-check"></i> Nosotros</div>
          </div>
          {compare.map((row, i) => (
            <div class={`gtable-row${i % 2 !== 0 ? ' gtable-row--alt' : ''}`}>
              <div class="gt-feat">{row.feat}</div>
              <div class="gt-other">{row.other}</div>
              <div class="gt-ours">{row.ours}</div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
  <section class="section section--cream">
    <div class="container">
      <span class="tag fade-in">Preguntas frecuentes</span>
      <h2 class="h2 fade-in fade-delay-1">Resolvemos tus dudas</h2>
      <div class="accordion fade-in fade-delay-2" id="faq-accordion">
        {faq.map(item => (
          <div class="accordion-item">
            <button class="accordion-toggle" aria-expanded="false" data-accordion>
              <span>{item.q}</span>
              <i class="ph ph-caret-down accordion-icon"></i>
            </button>
            <div class="accordion-body">
              <div class="accordion-body-inner"><p>{item.a}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA FINAL ─────────────────────────────────────────────────────── -->
  <section class="section section--navy">
    <div class="container cta-final fade-in" style="text-align:center;">
      <h2 class="h2" style="color:var(--white);">La próxima convocatoria llega más rápido de lo que crees.</h2>
      <p class="lead lead--white" style="max-width:560px; margin:0 auto 32px;">Cada semana sin un plan claro es una semana que juega en tu contra. Las plazas son limitadas y se asignan por orden de reserva.</p>
      <a href="#contacto" class="btn btn--sky btn--lg">Reserva tu plaza ahora →</a>
      <div class="cta-final-badges" style="margin-top:24px;">
        <span class="trust-badge"><i class="ph ph-user"></i> Tutorización individual</span>
        <span class="trust-badge"><i class="ph ph-bank"></i> Equipo con experiencia real</span>
        <span class="trust-badge"><i class="ph ph-laptop"></i> 100% online</span>
        <span class="trust-badge"><i class="ph ph-clock"></i> Plazas limitadas</span>
      </div>
      <blockquote class="hero-quote">"No es cuestión de estudiar más. Es cuestión de estudiar con quien ya conoce el camino."</blockquote>
    </div>
  </section>

  <ContactForm
    subject="Preparación de Oposiciones"
    title="Reserva tu plaza"
    subtitle="Cuéntanos tu situación y nos pondremos en contacto contigo para la sesión de diagnóstico inicial. Plazas limitadas."
  />

</BaseLayout>

<style>
/* ── Hero ─────────────────────────────────────────────────────────────── */
.prep-hero { padding: 120px 0 80px; position: relative; overflow: hidden; }
.prep-blob {
  position: absolute; border-radius: 50%;
  filter: blur(80px); pointer-events: none; z-index: 1;
}
.prep-blob-1 { width: 500px; height: 500px; background: var(--sky); opacity: .2; top: -200px; right: -100px; }
.prep-blob-2 { width: 300px; height: 300px; background: var(--blue); opacity: .25; bottom: -80px; left: 10%; }
.prep-hero-inner { position: relative; z-index: 2; }
.back-link {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: .82rem; font-weight: 600; color: rgba(255,255,255,.9);
  background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.22);
  border-radius: 999px; padding: 6px 14px;
  margin-bottom: 20px; transition: background .2s, border-color .2s;
}
.back-link:hover { background: rgba(255,255,255,.2); border-color: rgba(255,255,255,.38); }
.hero-trust { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0 32px; }
.trust-pill {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: .8rem; font-weight: 600; color: rgba(255,255,255,.8);
  background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12);
  padding: 6px 14px; border-radius: 999px;
}

/* ── Pain points ─────────────────────────────────────────────────────── */
.pain-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 40px;
}
.pain-card {
  background: var(--white); border-radius: 16px;
  padding: 24px; display: flex; flex-direction: column; gap: 12px;
  border: 1px solid rgba(19,16,59,.07);
}
.pain-icon { font-size: 1.6rem; color: var(--sky); }
.pain-card p { font-size: .9rem; color: var(--gray); line-height: 1.6; margin: 0; }
.conclusion-text {
  background: var(--navy); color: rgba(255,255,255,.85);
  border-radius: 16px; padding: 28px 32px;
  font-size: 1rem; line-height: 1.7; text-align: center;
}

/* ── Solution two-col ─────────────────────────────────────────────────── */
.section-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
.solution-visual { background: var(--cream); border-radius: 20px; padding: 32px; }
.team-list { display: flex; flex-direction: column; gap: 24px; }
.team-item { display: flex; align-items: flex-start; gap: 16px; }
.team-item > i { font-size: 1.8rem; color: var(--blue); flex-shrink: 0; margin-top: 2px; }
.team-item strong { display: block; font-size: .95rem; color: var(--navy); margin-bottom: 4px; }
.team-item p { font-size: .87rem; color: var(--gray); line-height: 1.55; margin: 0; }

/* ── Benefits ─────────────────────────────────────────────────────────── */
.benefits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
.benefit-card { background: var(--white); border-radius: 18px; padding: 28px; border: 1px solid rgba(19,16,59,.07); }
.benefit-icon { width: 48px; height: 48px; background: linear-gradient(135deg, var(--blue), var(--sky)); border-radius: 14px; display: flex; align-items: center; justify-content: center; color: var(--white); font-size: 1.4rem; margin-bottom: 16px; }
.benefit-card .h3 { margin-bottom: 10px; }
.benefit-card p { font-size: .88rem; color: var(--gray); line-height: 1.65; margin: 0; }

/* ── Profiles ─────────────────────────────────────────────────────────── */
.profiles-grid { display: flex; flex-direction: column; gap: 16px; margin-top: 40px; }
.profile-card-serv {
  display: flex; align-items: flex-start; gap: 20px;
  background: var(--cream); border-radius: 16px; padding: 24px;
}
.profile-icon-serv {
  flex-shrink: 0; width: 44px; height: 44px;
  background: linear-gradient(135deg, var(--blue), var(--sky));
  border-radius: 12px; display: flex; align-items: center; justify-content: center;
  font-size: 1.3rem; color: var(--white);
}
.profile-card-serv strong { display: block; font-size: .95rem; color: var(--navy); margin-bottom: 6px; }
.profile-card-serv p { font-size: .88rem; color: var(--gray); line-height: 1.6; margin: 0; }

/* ── Steps ────────────────────────────────────────────────────────────── */
.steps-grid { display: flex; flex-direction: column; gap: 16px; margin-top: 40px; }
.step-card { display: flex; align-items: flex-start; gap: 20px; background: var(--white); border-radius: 16px; padding: 24px; border: 1px solid rgba(19,16,59,.07); }
.step-num { flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%; background: var(--blue); color: var(--white); font-weight: 800; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; }
.step-card .h3 { margin-bottom: 6px; }
