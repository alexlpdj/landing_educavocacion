---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';

const waMessage = encodeURIComponent('Hola, me interesa el servicio de Creación de Temarios para oposiciones. ¿Podéis enviarme un presupuesto personalizado?');

const services = [
  { icon: 'ph-book-open', title: 'Temario completo', desc: 'Desarrollamos íntegramente todos los temas del cuerpo al que optas, con coherencia interna, estructura uniforme, normativa actualizada y bibliografía actualizada. Listo para estudiar desde el primer día.' },
  { icon: 'ph-note-pencil', title: 'Temas sueltos por encargo', desc: '¿Solo necesitas reforzar algunos temas concretos? Te elaboramos exactamente los que pidas, con la misma profundidad y rigor que un temario completo.' },
  { icon: 'ph-clipboard-text', title: 'Programación didáctica', desc: 'Diseño profesional de tu programación con todos los elementos curriculares exigidos: contextualización, objetivos, competencias, contenidos, metodología, evaluación, atención a la diversidad y vinculación normativa. Defensible ante cualquier tribunal.' },
  { icon: 'ph-puzzle-piece', title: 'Unidades Didácticas', desc: 'Elaboramos UD coherentes con tu programación, con actividades, recursos, temporalización, criterios e instrumentos de evaluación. Listas para exponer.' },
  { icon: 'ph-magnifying-glass', title: 'Revisión y mejora de materiales propios', desc: '¿Ya tienes temario, programación o UD? Te hacemos una revisión por capas: estructura, contenido, bibliografía, estilo, normativa. Te entregamos tu material reescrito y mejorado.' },
];

const benefits = [
  { icon: 'ph-check-square', title: 'Temario a medida y listo para estudiar', desc: 'Nada de plantillas genéricas ni temas reciclados. Cada material se elabora específicamente para tu oposición, tu cuerpo y tu comunidad autónoma cuando aplica.' },
  { icon: 'ph-scales', title: 'Rigurosidad y actualización normativa', desc: 'Cada tema se contrasta con la normativa vigente en el momento de la entrega: leyes orgánicas, decretos, órdenes, instrucciones. Si la normativa cambia, sabemos cuándo y dónde reflejarlo.' },
  { icon: 'ph-users-three', title: 'Revisión por docentes y funcionarios en activo', desc: 'Tu material no lo escribe un becario. Lo desarrolla un equipo formado por docentes en activo, preparadores con recorrido y funcionariado en ejercicio.' },
  { icon: 'ph-lightning', title: 'Metodología de alto impacto', desc: 'No solo escribimos: diseñamos para aprender. Estructuras claras, jerarquía visual, ideas fuerza destacadas, esquemas integrados, mapas mentales y ejemplos prácticos.' },
  { icon: 'ph-star', title: 'Enfoque diferenciador', desc: 'Tu temario tiene que destacar entre cientos. Buscamos el matiz, la cita actualizada y el enfoque pedagógico contemporáneo que hace que un tribunal diga "este opositor sabe de lo que habla".' },
  { icon: 'ph-palette', title: 'Diseño pedagógico y presentacional', desc: 'No es lo mismo estudiar un bloque de texto plano que un material bien tipografiado, jerarquizado y visualmente claro. Cuidamos la presentación porque afecta a tu rendimiento.' },
];

const profiles = [
  { icon: 'ph-plant', title: 'Aspirantes que empiezan desde cero', desc: 'Necesitas un temario completo, coherente y actualizado, sin perder semanas buscando materiales dispersos por internet.', note: 'Empiezas a estudiar el primer día. No el día que termines de buscar materiales.' },
  { icon: 'ph-trend-up', title: 'Opositores con base previa que quieren mejorar', desc: 'Ya tienes materiales, pero necesitan revisión técnica, alineación con criterios de tribunal, mejora de estructura, legislación actualizada y bibliografía sólida.', note: 'Te entregamos tu propio temario reescrito al nivel que merece.' },
  { icon: 'ph-scales', title: 'Quienes compaginan estudio con trabajo o familia', desc: 'Buscas materiales claros, accionables y eficientes: resúmenes, mapas mentales, esquemas y propuestas de cómo estudiar cada tema.', note: 'Aprovechas cada minuto que tengas, sin perder tiempo organizando materiales.' },
  { icon: 'ph-target', title: 'Opositores con pruebas prácticas y/o didácticas', desc: 'Necesitas enfoque aplicado: casos, supuestos, ejemplos, actividades, rúbricas de evaluación, vinculación curricular y coherencia total entre temario y programación.', note: 'Todo el material habla el mismo idioma. Como debe ser.' },
  { icon: 'ph-arrow-counter-clockwise', title: 'Quienes ya han suspendido por "temario flojo"', desc: 'Sabes que tu temario no estaba a la altura. Necesitas diagnóstico de calidad, reescritura profesional y un plan de mejora realista.', note: 'Esta vez, el temario no será el problema.' },
];

const steps = [
  { n:'1', title:'Cuéntanos tu oposición', desc:'Nos dices qué proceso preparas, en qué punto estás y qué necesitas: temario completo, temas sueltos, programación didáctica, unidades didácticas o revisión.' },
  { n:'2', title:'Te enviamos un presupuesto personalizado', desc:'Sin compromiso. Adaptado a tu punto de partida, plazos y nivel de servicio elegido (desde cero / revisión / mejora premium).' },
  { n:'3', title:'Briefing y arranque', desc:'Si das luz verde, profundizamos en tus necesidades: cuerpo, comunidad autónoma, especialidad, normativa de referencia y criterios del tribunal.' },
  { n:'4', title:'Elaboración profesional', desc:'Nuestro equipo desarrolla tu material con revisión cruzada entre docentes, preparadores y funcionarios en activo. Recibes entregas parciales para validar el rumbo.' },
  { n:'5', title:'Revisión y entrega final', desc:'Te entregamos el material listo para estudiar, en formato editable y con todas las garantías de actualización normativa y rigor académico.' },
  { n:'6', title:'Soporte posterior', desc:'Si surge una actualización normativa relevante o necesitas ajustes, seguimos a tu lado.' },
];

const faq = [
  { q:'¿Cuánto cuesta el servicio?', a:'El precio varía según el alcance (temario completo, temas sueltos, programación, UD o revisión), la oposición, el nivel de servicio y los plazos. Te enviamos un presupuesto personalizado sin compromiso una vez nos cuentas qué necesitas.' },
  { q:'¿Para qué oposiciones elaboráis temarios?', a:'Trabajamos con un enfoque generalista: cuerpos docentes (Infantil, Primaria, Secundaria, FP, EOI), administraciones públicas (estatal, autonómica, local), ámbito sanitario, justicia, fuerzas y cuerpos de seguridad y otros procesos selectivos.' },
  { q:'¿En cuánto tiempo me lo entregáis?', a:'Depende del alcance y de tu fecha de convocatoria. En el presupuesto te confirmamos un plazo realista y, si es necesario, podemos planificar entregas parciales para que empieces a estudiar antes.' },
  { q:'¿El temario lo recibo en formato editable?', a:'Sí. Te entregamos el material en formato editable para que puedas adaptarlo, ampliarlo o personalizarlo a tu manera de estudiar.' },
  { q:'¿Y si cambia la normativa después de la entrega?', a:'Si se produce una actualización normativa relevante en un plazo razonable, te ajustamos los temas afectados. Las condiciones exactas se concretan en el presupuesto.' },
  { q:'¿Podéis elaborar también la programación didáctica y las unidades didácticas?', a:'Sí. Elaboramos temario, temas sueltos, programación didáctica y unidades didácticas, y nos aseguramos de que todo sea coherente entre sí.' },
  { q:'¿Y si solo necesito que reviséis mi temario actual?', a:'Perfecto. Hacemos revisión por capas: estructura, contenido, bibliografía, estilo y normativa. Te entregamos tu temario corregido y mejorado, con los puntos débiles solucionados.' },
  { q:'¿Quién va a elaborar mi material?', a:'Tu material lo desarrolla un equipo de docentes en activo, preparadores de oposiciones y funcionariado en ejercicio, con revisión cruzada para garantizar rigor y criterios de tribunal.' },
];

const compare = [
  { feat:'Actualización normativa', other:'Incierta o desactualizada',      ours:'Contrastada y vigente' },
  { feat:'Autoría',                 other:'Anónima o desconocida',          ours:'Docentes, preparadores y funcionarios' },
  { feat:'Adaptación',              other:'Plantilla genérica',              ours:'A medida de tu oposición y CC.AA.' },
  { feat:'Coherencia interna',      other:'Temas con criterios distintos',  ours:'Estructura uniforme y trazable' },
  { feat:'Diseño pedagógico',       other:'Texto plano',                    ours:'Jerarquizado, esquematizado, accionable' },
  { feat:'Bibliografía',            other:'Reciclada o ausente',            ours:'Actualizada y comentada' },
  { feat:'Soporte',                 other:'Ninguno',                        ours:'Acompañamiento y ajustes incluidos' },
];
---

<BaseLayout
  title="Creación de Temarios para Oposiciones — EducaVocación"
  description="Servicio profesional de elaboración de temarios, programaciones didácticas y unidades didácticas para oposiciones. Adaptado a tu cuerpo, actualizado a la normativa vigente."
  waMessage={waMessage}
  showWhatsApp={true}
>

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="section section--navy tem-hero">
    <div class="tem-blob tem-blob-1"></div>
    <div class="tem-blob tem-blob-2"></div>
    <div class="container tem-hero-inner fade-in">
      <a href="/#servicios" class="back-link"><i class="ph ph-arrow-left"></i> Servicios</a>
      <span class="tag">Creación de temarios</span>
      <h1 class="h1" style="color:var(--white); margin-bottom:20px;">
        Tu temario es la mitad del aprobado.<br><em style="font-style:normal; color:var(--sky);">Hagámoslo bien desde el principio.</em>
      </h1>
      <p class="lead lead--white" style="max-width:620px;">
        Servicio profesional de elaboración de temarios, temas sueltos, programaciones didácticas y unidades didácticas para oposiciones. Olvídate de juntar PDFs sueltos o estudiar con materiales que ningún tribunal valoraría.
      </p>
      <div class="hero-trust">
        <span class="trust-pill"><i class="ph ph-check-circle"></i> Adaptado a tu oposición</span>
        <span class="trust-pill"><i class="ph ph-check-circle"></i> Revisado por funcionarios en activo</span>
        <span class="trust-pill"><i class="ph ph-check-circle"></i> Actualizado a la normativa vigente</span>
        <span class="trust-pill"><i class="ph ph-check-circle"></i> Sin compromiso</span>
      </div>
      <a href="#contacto" class="btn btn--sky btn--lg">
        Solicitar presupuesto sin compromiso →
      </a>
    </div>
  </section>

  <!-- ── EL PROBLEMA ───────────────────────────────────────────────────── -->
  <section class="section section--cream">
    <div class="container">
      <div class="fade-in" style="max-width:680px; margin-bottom:48px;">
        <span class="tag tag--navy">El problema</span>
        <h2 class="h2">El 90% de los opositores estudia con materiales que les juegan en contra.</h2>
      </div>
      <div class="pain-grid fade-in fade-delay-1">
        <div class="pain-card"><i class="ph ph-files pain-icon"></i><p>Has acumulado decenas de PDFs, apuntes y resúmenes sin saber cuáles están actualizados.</p></div>
        <div class="pain-card"><i class="ph ph-scales pain-icon"></i><p>Estudias temas que no reflejan la normativa vigente — y eso, en un examen, es un suspenso directo.</p></div>
        <div class="pain-card"><i class="ph ph-arrows-out pain-icon"></i><p>Tu temario es incoherente: unos temas con 30 páginas, otros con 5, sin estructura común.</p></div>
        <div class="pain-card"><i class="ph ph-target pain-icon"></i><p>No sabes si lo que estudias se ajusta a los criterios reales del tribunal.</p></div>
        <div class="pain-card"><i class="ph ph-puzzle-piece pain-icon"></i><p>Tienes la programación por un lado, las UD por otro y el temario por otro. Nada encaja.</p></div>
        <div class="pain-card"><i class="ph ph-clock pain-icon"></i><p>Has dedicado más tiempo a buscar y maquetar materiales que a estudiarlos de verdad.</p></div>
      </div>
      <p class="conclusion-text fade-in fade-delay-2">
        Estudiar mucho con un temario malo no te lleva al aprobado. <strong>Te lleva al agotamiento.</strong>
      </p>
    </div>
  </section>

  <!-- ── LA SOLUCIÓN ───────────────────────────────────────────────────── -->
  <section class="section section--white">
    <div class="container" style="max-width:760px;">
      <span class="tag fade-in">La solución</span>
      <h2 class="h2 fade-in fade-delay-1">Un servicio profesional de elaboración de temario, hecho a medida de tu oposición.</h2>
      <p class="lead fade-in fade-delay-2">Si necesitas ayuda en la elaboración de tu temario, podemos ayudarte a desarrollarlo con criterios profesionales y adaptados a la normativa vigente. Nuestro equipo te ayudará a crear un material sólido, estructurado y alineado con lo que realmente valoran los tribunales.</p>
      <p class="lead fade-in fade-delay-2" style="margin-top:12px;">No copiamos. No reciclamos. <strong>Creamos tu material desde el rigor académico, la actualización normativa y los criterios reales de evaluación de los tribunales.</strong></p>
      <div style="margin-top:32px;" class="fade-in fade-delay-3">
        <a href="#contacto" class="btn btn--primary btn--lg">Cuéntanos tu oposición →</a>
      </div>
    </div>
  </section>

  <!-- ── QUÉ PODEMOS CREAR ─────────────────────────────────────────────── -->
  <section class="section section--light">
    <div class="container">
      <span class="tag fade-in">Nuestros servicios</span>
      <h2 class="h2 fade-in fade-delay-1">Un servicio integral. Tú decides hasta dónde llegamos.</h2>
      <div class="services-grid fade-in fade-delay-2">
        {services.map(s => (
          <div class="service-item">
            <div class="service-icon"><i class={`ph ${s.icon}`}></i></div>
            <div>
              <h3 class="h3">{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── BENEFICIOS ────────────────────────────────────────────────────── -->
  <section class="section section--cream">
    <div class="container">
      <span class="tag fade-in">Qué te llevas</span>
      <h2 class="h2 fade-in fade-delay-1">Lo que obtienes cuando trabajamos contigo</h2>
      <div class="benefits-grid">
        {benefits.map((b, i) => (
          <div class={`benefit-card fade-in fade-delay-${Math.min(i+1,3)}`}>
            <div class="benefit-icon"><i class={`ph ${b.icon}`}></i></div>
            <h3 class="h3">{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── A QUIÉN VA DIRIGIDO ───────────────────────────────────────────── -->
  <section class="section section--white">
    <div class="container">
      <span class="tag fade-in">Destinatarios</span>
      <h2 class="h2 fade-in fade-delay-1">Si tu oposición depende de tu temario, este servicio es para ti.</h2>
      <div class="profiles-grid fade-in fade-delay-2">
        {profiles.map(p => (
          <div class="profile-card-tem">
            <div class="profile-head">
              <div class="profile-icon-tem"><i class={`ph ${p.icon}`}></i></div>
              <strong>{p.title}</strong>
            </div>
            <p>{p.desc}</p>
            <p class="profile-note"><em>{p.note}</em></p>
          </div>
        ))}
      </div>
      <div style="text-align:center; margin-top:48px;" class="fade-in">
        <a href="#contacto" class="btn btn--primary btn--lg">Solicitar presupuesto personalizado →</a>
      </div>
    </div>
  </section>

  <!-- ── CÓMO TRABAJAMOS ───────────────────────────────────────────────── -->
  <section class="section section--light">
    <div class="container">
      <span class="tag fade-in">El proceso</span>
      <h2 class="h2 fade-in fade-delay-1">Un proceso transparente, profesional y a medida</h2>
      <div class="steps-grid fade-in fade-delay-2">
        {steps.map(s => (
          <div class="step-card">
            <div class="step-num">{s.n}</div>
            <div>
              <h3 class="h3">{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── COMPARATIVA ───────────────────────────────────────────────────── -->
  <section class="compare-section">
    <div class="compare-glow compare-glow-1"></div>
    <div class="compare-glow compare-glow-2"></div>
    <div class="container">
      <span class="tag fade-in" style="background:rgba(41,171,226,.15);color:var(--sky);">Por qué confiar en nosotros</span>
      <h2 class="h2 fade-in fade-delay-1" style="color:var(--white);">Lo que nos hace diferentes</h2>
      <div class="glass-compare fade-in fade-delay-2">

        <!-- Desktop: dos paneles glass -->
        <div class="gcp-wrap">
          <div class="glass-panel glass-panel--other">
            <div class="glass-panel-header">
              <span class="panel-label panel-label--other"><i class="ph ph-x-circle"></i> Otros</span>
            </div>
            <ul class="glass-list">
              {compare.map(row => (
                <li>
                  <span class="feat-label">{row.feat}</span>
                  <span class="feat-val feat-val--other"><i class="ph ph-x-circle fv-icon"></i>{row.other}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="glass-panel glass-panel--ours">
            <div class="glass-shine"></div>
            <div class="glass-panel-header">
              <span class="panel-label panel-label--ours"><i class="ph ph-seal-check"></i> Nuestro servicio</span>
            </div>
            <ul class="glass-list">
              {compare.map(row => (
                <li>
                  <span class="feat-label">{row.feat}</span>
                  <span class="feat-val feat-val--ours"><i class="ph ph-check-circle fv-icon"></i>{row.ours}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Mobile: tabla 3 columnas -->
        <div class="gtable-mobile">
          <div class="gtable-head">
            <div class="gt-h gt-h--feat"></div>
            <div class="gt-h gt-h--other"><i class="ph ph-x-circle"></i> Otros</div>
            <div class="gt-h gt-h--ours"><i class="ph ph-seal-check"></i> Nosotros</div>
          </div>
          {compare.map((row, i) => (
            <div class={`gtable-row${i % 2 !== 0 ? ' gtable-row--alt' : ''}`}>
              <div class="gt-feat">{row.feat}</div>
              <div class="gt-other">{row.other}</div>
              <div class="gt-ours">{row.ours}</div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
  <section class="section section--cream">
    <div class="container">
      <span class="tag fade-in">Preguntas frecuentes</span>
      <h2 class="h2 fade-in fade-delay-1">Resolvemos tus dudas</h2>
      <div class="accordion fade-in fade-delay-2" id="faq-accordion">
        {faq.map(item => (
          <div class="accordion-item">
            <button class="accordion-toggle" aria-expanded="false" data-accordion>
              <span>{item.q}</span>
              <i class="ph ph-caret-down accordion-icon"></i>
            </button>
            <div class="accordion-body">
              <div class="accordion-body-inner"><p>{item.a}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA FINAL ─────────────────────────────────────────────────────── -->
  <section class="section section--navy">
    <div class="container cta-final fade-in" style="text-align:center;">
      <h2 class="h2" style="color:var(--white);">La diferencia entre aprobar y suspender empieza en tu temario.</h2>
      <p class="lead lead--white" style="max-width:560px; margin:0 auto 32px;">Cada semana que estudias con un material flojo es una semana que juega en tu contra. No hay segundas oportunidades baratas en una oposición.</p>
      <a href="#contacto" class="btn btn--sky btn--lg">Solicitar presupuesto personalizado →</a>
      <div class="cta-final-badges" style="margin-top:24px;">
        <span class="trust-badge"><i class="ph ph-check-circle"></i> Sin compromiso</span>
        <span class="trust-badge"><i class="ph ph-file-text"></i> Adaptado a tu oposición</span>
        <span class="trust-badge"><i class="ph ph-clock"></i> Respuesta en menos de 48 h</span>
      </div>
    </div>
  </section>

  <ContactForm
    subject="Creación de Temarios"
    title="Solicita tu presupuesto"
    subtitle="Cuéntanos tu oposición y especialidad. Te enviamos una propuesta personalizada en menos de 48 horas, sin compromiso."
  />

</BaseLayout>

<style>
/* ── Hero ─────────────────────────────────────────────────────────────── */
.tem-hero { padding: 120px 0 80px; position: relative; overflow: hidden; }
.tem-blob {
  position: absolute; border-radius: 50%;
  filter: blur(80px); pointer-events: none; z-index: 1;
}
.tem-blob-1 { width: 500px; height: 500px; background: var(--blue); opacity: .2; top: -150px; right: -100px; }
.tem-blob-2 { width: 350px; height: 350px; background: var(--sky); opacity: .2; bottom: -100px; left: 5%; }
.tem-hero-inner { position: relative; z-index: 2; }
.back-link {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: .82rem; font-weight: 600; color: rgba(255,255,255,.9);
  background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.22);
  border-radius: 999px; padding: 6px 14px;
  margin-bottom: 20px; transition: background .2s, border-color .2s;
}
.back-link:hover { background: rgba(255,255,255,.2); border-color: rgba(255,255,255,.38); }
.hero-trust { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0 32px; }
.trust-pill {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: .8rem; font-weight: 600; color: rgba(255,255,255,.8);
  background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12);
  padding: 6px 14px; border-radius: 999px;
}

/* ── Pain points ─────────────────────────────────────────────────────── */
.pain-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 40px; }
.pain-card { background: var(--white); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 12px; border: 1px solid rgba(19,16,59,.07); }
.pain-icon { font-size: 1.6rem; color: var(--sky); }
.pain-card p { font-size: .9rem; color: var(--gray); line-height: 1.6; margin: 0; }
.conclusion-text { background: var(--navy); color: rgba(255,255,255,.85); border-radius: 16px; padding: 28px 32px; font-size: 1rem; line-height: 1.7; text-align: center; }

/* ── Services grid ────────────────────────────────────────────────────── */
.services-grid { display: flex; flex-direction: column; gap: 16px; margin-top: 40px; }
.service-item { display: flex; align-items: flex-start; gap: 20px; background: var(--white); border-radius: 16px; padding: 24px; border: 1px solid rgba(19,16,59,.07); }
.service-icon { flex-shrink: 0; width: 48px; height: 48px; background: linear-gradient(135deg, var(--blue), var(--sky)); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: var(--white); }
.service-item .h3 { margin-bottom: 8px; }
.service-item p { font-size: .88rem; color: var(--gray); line-height: 1.65; margin: 0; }

/* ── Benefits ─────────────────────────────────────────────────────────── */
.benefits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
.benefit-card { background: var(--white); border-radius: 18px; padding: 28px; border: 1px solid rgba(19,16,59,.07); }
.benefit-icon { width: 48px; height: 48px; background: linear-gradient(135deg, var(--blue), var(--sky)); border-radius: 14px; display: flex; align-items: center; justify-content: center; color: var(--white); font-size: 1.4rem; margin-bottom: 16px; }
.benefit-card .h3 { margin-bottom: 10px; }
.benefit-card p { font-size: .88rem; color: var(--gray); line-height: 1.65; margin: 0; }

