---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DesignSwitcher from '../../../components/DesignSwitcher.astro';

export async function getStaticPaths() {
  const courses = await getCollection('cursos');
  return courses.map(course => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const { data } = course;
const { Content } = await course.render();

const waMessage = encodeURIComponent(`Hola, me interesa el curso "${data.title}". ¿Me puedes dar más información?`);
const ctaHref = `/matricula/${course.slug}/`;

const introIcons = ['ph-chalkboard-teacher', 'ph-tree-structure', 'ph-arrows-out', 'ph-users-three'];
---

<BaseLayout title={`${data.title} — EducaVocación`} description={data.description} waMessage={waMessage}>

  <DesignSwitcher slug={course.slug} current="b" />

  <!-- ── HERO ─────────────────────────────────────────────────────────── -->
  <section class="hero" id="top">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="container">
      <div class="hero__inner">

        <!-- Izquierda -->
        <div>
          <nav class="hero__breadcrumb">
            <a href="/">Inicio</a>
            <i class="ph ph-caret-right"></i>
            <a href="/cursos/">Cursos</a>
            <i class="ph ph-caret-right"></i>
            <span>{data.title}</span>
          </nav>
          <div class="hero__tags fade-in">
            <span class="tag tag--white"><i class="ph ph-graduation-cap"></i> {data.ects} créditos ECTS</span>
            <span class="tag tag--white"><i class="ph ph-buildings"></i> EUNEIZ</span>
            <span class="tag tag--sky"><i class="ph ph-seal-check"></i> Válido en oposiciones</span>
          </div>
          <h1 class="h1 hero__title fade-in fade-delay-1">
            {data.title}
          </h1>
          <p class="hero__subtitle fade-in fade-delay-2">
            {data.description}
          </p>
          <div class="hero__pills fade-in fade-delay-3">
            <span class="hero__pill"><i class="ph ph-clock"></i> {data.hours} horas</span>
            <span class="hero__pill"><i class="ph ph-laptop"></i> {data.modality}</span>
            <span class="hero__pill"><i class="ph ph-books"></i> {data.modules.length} módulos</span>
            <span class="hero__pill"><i class="ph ph-certificate"></i> Diploma digital</span>
          </div>
        </div>

        <!-- Derecha: tarjeta -->
        <div class="fade-in fade-delay-2">
          <div class="course-card">
            <div class="course-card__img" style={data.image ? `background-image:url('${data.image}');background-size:cover;background-position:center;` : undefined}>
              {!data.image && <i class="ph-fill ph-graduation-cap course-card__img-icon"></i>}
              {!data.image && <span class="course-card__img-text">Formación docente · EUNEIZ</span>}
            </div>
            <div class="course-card__body">
              <div class="course-card__price">
                <span class="course-card__amount">{data.price}</span>
                <span class="course-card__currency">€</span>
              </div>
              {data.packEligible && (
                <p class="course-card__pack-hint">
                  <i class="ph-fill ph-fire"></i>
                  Pack 2 cursos por 40 € — el 2.º a 8 €
                </p>
              )}
              <div class="course-card__meta">
                <div class="course-card__meta-row">
                  <i class="ph ph-clock"></i><span>{data.hours} horas · {data.ects} créditos ECTS</span>
                </div>
                <div class="course-card__meta-row">
                  <i class="ph ph-laptop"></i><span>{data.modality} · a tu ritmo</span>
                </div>
                <div class="course-card__meta-row">
                  <i class="ph ph-buildings"></i><span>Acreditado por Universidad EUNEIZ</span>
                </div>
                <div class="course-card__meta-row">
                  <i class="ph ph-seal-check"></i><span>Válido como mérito en oposiciones</span>
                </div>
              </div>
              <div class="course-card__cta">
                <a href={ctaHref} class="btn btn--primary btn--full">
                  <i class="ph ph-lock-key"></i> Matricúlate ahora — {data.price} €
                </a>
                {data.packEligible && (
                  <a href="#pack" class="btn btn--ghost btn--full">
                    <i class="ph-fill ph-fire" style="color:var(--sky)"></i> Ver oferta pack 2×1
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── INTRO / PROBLEMA ─────────────────────────────────────────────── -->
  <section class="section section--cream" id="descripcion">
    <div class="container">
      <div class="intro-grid">
        <div>
          <span class="section-label">El problema</span>
          <h2 class="h2" style="margin-bottom:18px">¿Por qué necesitas este curso?</h2>
          <div class="lead intro-content">
            <Content />
          </div>
        </div>
        <div>
          <div class="intro__list">
            {data.benefits.slice(0, 4).map((benefit, i) => (
              <div class="intro__item">
                <div class="intro__item-icon"><i class={`ph ${introIcons[i]}`}></i></div>
                <p>{benefit}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── STATS ────────────────────────────────────────────────────────── -->
  <section class="section-stats" id="resumen">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <i class="ph ph-currency-eur stat-icon"></i>
          <div class="stat-value">{data.price} €</div>
          <div class="stat-label">Precio único</div>
        </div>
        <div class="stat-card">
          <i class="ph ph-clock stat-icon"></i>
          <div class="stat-value">{data.hours} h</div>
          <div class="stat-label">Horas de formación</div>
        </div>
        <div class="stat-card">
          <i class="ph ph-graduation-cap stat-icon"></i>
          <div class="stat-value">{data.ects} ECTS</div>
          <div class="stat-label">Créditos universitarios</div>
        </div>
        <div class="stat-card">
          <i class="ph ph-laptop stat-icon"></i>
          <div class="stat-value">Online</div>
          <div class="stat-label">100% virtual · a tu ritmo</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PROGRAMA ──────────────────────────────────────────────────────── -->
  <section class="section section--cream" id="programa">
    <div class="container">
      <div class="programa-header">
        <div>
          <span class="section-label">Temario</span>
          <h2 class="h2">Programa formativo</h2>
          <p class="lead" style="margin-top:8px; max-width:520px">
            {data.modules.length} módulos para dominar la intervención con rigor y eficacia
          </p>
        </div>
        <div class="programa-count">
          <i class="ph ph-books"></i> {data.modules.length} módulos · {data.hours} horas
        </div>
      </div>
      <div class="acordeon">
        {data.modules.map((mod, i) => (
          <div class={`acordeon__item${i === 0 ? ' is-open' : ''}`}>
            <div class="acordeon__header">
              <div class="acordeon__num">M{i + 1}</div>
              <span class="acordeon__title">{mod.title}</span>
              <div class="acordeon__chevron"><i class="ph ph-caret-down"></i></div>
            </div>
            <div class="acordeon__body" style={i === 0 ? 'max-height:300px' : undefined}>
              <div class="acordeon__body-inner">{mod.description}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PARA QUIÉN ────────────────────────────────────────────────────── -->
  <section class="section section--navy" id="para-quien">
    <div class="container">
      <div style="text-align:center; margin-bottom:8px;">
        <span class="section-label">Destinatarios</span>
        <h2 class="h2" style="color:var(--white); max-width:580px; margin:0 auto 14px;">¿Para quién es este curso?</h2>
        <p style="color:rgba(255,255,255,.62); font-size:.95rem; max-width:500px; margin:0 auto;">
          Si trabajas con alumnado o quieres mejorar tu práctica educativa, este curso es para ti.
        </p>
      </div>
      <div class="audience-grid">
        {data.profiles.map(profile => (
          <div class="audience-card">
            <div class="audience-card__icon"><i class={`ph ${profile.icon}`}></i></div>
            <div>
              <p class="audience-card__title">{profile.title}</p>
              <p class="audience-card__desc">{profile.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── LOGROS ────────────────────────────────────────────────────────── -->
  <section class="section section--light" id="logros">
    <div class="container">
      <div class="logros-two-col">
        <div>
          <span class="section-label">Resultados</span>
          <h2 class="h2" style="margin-bottom:14px">Al terminar este curso serás capaz de…</h2>
          <p class="lead">Competencias reales, aplicables desde el primer día.</p>
        </div>
        <div class="logros-list">
          {data.benefits.map(benefit => (
            <div class="logro-item">
              <div class="logro-item__check"><i class="ph-fill ph-check-circle"></i></div>
              <p>{benefit}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CÓMO SE SUPERA ────────────────────────────────────────────────── -->
  <section class="section section--cream" id="superacion">
    <div class="container" style="max-width:860px;">
      <div style="text-align:center; margin-bottom:40px;">
        <span class="section-label">Evaluación</span>
        <h2 class="h2">Evaluación y superación del curso</h2>
        <p class="lead" style="margin-top:8px">Sencillo, riguroso y 100% aplicable a tu práctica profesional.</p>
      </div>
      <div class="evaluation-cards-v2">
        <div class="evaluation-card-v2">
          <div class="evaluation-icon-v2">
            <i class="ph ph-test-tube"></i>
          </div>
          <div>
            <h3 class="h3">Prueba tipo test</h3>
            <p>Para superar el curso, el alumnado deberá realizar una prueba tipo test al finalizar la formación. Será necesario obtener una calificación igual o superior a 7 sobre 10 para considerar el curso superado y acreditar su aprovechamiento.</p>
          </div>
        </div>
        <div class="evaluation-card-v2">
          <div class="evaluation-icon-v2">
            <i class="ph ph-arrow-clockwise"></i>
          </div>
          <div>
            <h3 class="h3">Segunda oportunidad</h3>
            <p>En caso de no alcanzar la puntuación mínima en la primera prueba, el alumnado dispondrá de una segunda oportunidad, pudiendo realizar una nueva prueba para superar el curso.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PROFESORADO ───────────────────────────────────────────────────── -->
  <section class="section section--white" id="profesorado">
    <div class="container">
      <div style="text-align:center;">
        <span class="section-label">Tu formador</span>
        <h2 class="h2">Aprende de quien lo vive desde dentro</h2>
      </div>
      <div class="profesor-card">
        <div class="profesor-photo-col">
          <div class="profesor-photo-ring">
            {data.profesorPhoto
              ? <img src={data.profesorPhoto} alt={`Foto de ${data.profesorName}`} class="profesor-photo" loading="lazy" />
              : <div class="profesor-photo-placeholder"><i class="ph ph-user"></i></div>
            }
          </div>
          <div class="profesor-badge-row">
            <span class="profesor-badge"><i class="ph ph-buildings"></i> UNED</span>
            <span class="profesor-badge"><i class="ph ph-chalkboard-teacher"></i> Docente</span>
          </div>
        </div>
        <div>
          <p class="profesor-card__name">{data.profesorName}</p>
          <p class="profesor-card__role">{data.profesorRole}</p>
          <p class="profesor-card__bio">{data.profesorBio}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PACK 2×1 ──────────────────────────────────────────────────────── -->
  {data.packEligible && (
    <section class="section section--light" id="pack">
      <div class="container">
        <div class="pack-card">
          <div class="pack-badge"><i class="ph-fill ph-fire"></i> Oferta por tiempo limitado</div>
          <h2 class="h2" style="margin-bottom:6px">Llévate 2 cursos por solo 40 €</h2>
          <p class="lead">El segundo te sale a <strong style="color:var(--blue)">8 €</strong>. Elige cualquier combinación del catálogo.</p>
          <div class="pack-prices">
            <span class="pack-prices__main">40 €</span>
            <span class="pack-prices__old">64 €</span>
            <span class="pack-prices__saving">Ahorras 24 € (37,5%)</span>
          </div>
          <div class="pack-rules">
            <div class="pack-rule"><i class="ph-fill ph-check-circle"></i> Matrícula simultánea en dos cursos de 50 horas y 32 €</div>
            <div class="pack-rule"><i class="ph-fill ph-check-circle"></i> Cualquier combinación: tú eliges los dos cursos</div>
            <div class="pack-rule"><i class="ph-fill ph-check-circle"></i> Todos los cursos virtuales, acreditados por EUNEIZ (2 ECTS c/u)</div>
            <div class="pack-rule"><i class="ph ph-x-circle" style="color:var(--gray)"></i> No acumulable con otras ofertas o descuentos</div>
          </div>
          <div class="pack-btns">
            <a href={data.stripePackLink || ctaHref} target="_blank" class="btn btn--primary">
              <i class="ph-fill ph-fire"></i> Aprovechar la oferta pack
            </a>
            <a href="/cursos/" class="btn btn--ghost">
              <i class="ph ph-list-bullets"></i> Ver todos los cursos
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ── CERTIFICADO ───────────────────────────────────────────────────── -->
  <section class="section section--white" id="certificado">
    <div class="container">
      <div class="cert-grid">
        <div>
          <span class="section-label">Acreditación</span>
          <h2 class="h2" style="margin-bottom:28px">Acredita la Universidad de Vitoria-Gasteiz EUNEIZ</h2>
          <div class="cert-list">
            <div class="cert-item">
              <div class="cert-item__icon"><i class="ph ph-seal-check"></i></div>
              <div>
                <p class="cert-item__desc">Título acreditado por la Universidad de Vitoria-Gasteiz EUNEIZ.</p>
              </div>
            </div>
            <div class="cert-item">
              <div class="cert-item__icon"><i class="ph ph-trophy"></i></div>
              <div>
                <p class="cert-item__desc">Curso puntuable como méritos para oposiciones de acceso a la función pública docente en todas las CC.AA., según R.D. 276/2007 de 23 de febrero (BOE 2/3/2007).</p>
              </div>
            </div>
            <div class="cert-item">
              <div class="cert-item__icon"><i class="ph ph-envelope"></i></div>
              <div>
                <p class="cert-item__desc">La certificación será remitida por la Universidad y se hace mediante diploma con firma digital, que recibirá en su e-mail para descargarlo en el plazo aproximado de 30-45 días desde el cierre de la edición del curso.</p>
              </div>
            </div>
          </div>
        </div>
        <div>
          <div class="cert-visual">
            <img src="/img/Logo_EUNEIZ_2023.jpg" alt="Universidad EUNEIZ" class="cert-logo-img" loading="lazy" />
            <h4>Diploma universitario</h4>
            <p>{data.title}</p>
            <p style="margin-top:6px; font-size:.75rem; color:var(--gray)">{data.hours} horas · {data.ects} créditos ECTS</p>
            <div style="margin:18px 0; border-top:1px solid var(--gray-light); border-bottom:1px solid var(--gray-light); padding:12px 0;">
              <p style="font-size:.8rem; font-weight:700; color:var(--navy)">Universidad de Vitoria-Gasteiz</p>
              <p style="font-size:.78rem; color:var(--gray)">EUNEIZ</p>
            </div>
            <div class="cert-visual__seal">
              <i class="ph-fill ph-seal-check"></i> Firma digital oficial
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="section section--cream" id="faq">
    <div class="container">
      <div style="text-align:center; margin-bottom:40px;">
        <span class="section-label">Preguntas frecuentes</span>
        <h2 class="h2">Todo lo que necesitas saber</h2>
      </div>
      <div class="faq-grid">
        {data.faq.map(item => (
          <div class="faq-item">
            <div class="faq-header">
              <span class="faq-question">{item.question}</span>
              <i class="ph ph-caret-down faq-chevron"></i>
            </div>
            <div class="faq-body">
              <div class="faq-body-inner">{item.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA FINAL ─────────────────────────────────────────────────────── -->
  <section class="cta-final" id="matricula">
    <div class="container">
      <span class="section-label">Empieza hoy</span>
      <h2 class="cta-final__title">Empieza hoy. Tu próxima oposición te lo agradecerá.</h2>
      <p class="cta-final__sub">Formación online, acreditada por universidad y válida como mérito. Solo {data.price} €.</p>
      <div class="cta-final__btns">
        <a href={ctaHref} class="btn btn--sky btn--lg">
          <i class="ph ph-lock-key"></i> Matricúlate ahora — {data.price} €
        </a>
        {data.packEligible && (
          <a href="#pack" class="btn btn--outline-white btn--lg">
            <i class="ph-fill ph-fire"></i> Ver oferta pack 2×1
          </a>
        )}
      </div>
      <div class="cta-final__pills">
        <span class="cta-final__pill"><i class="ph ph-graduation-cap"></i> {data.ects} créditos ECTS</span>
        <span class="cta-final__pill"><i class="ph ph-buildings"></i> Universidad EUNEIZ</span>
        <span class="cta-final__pill"><i class="ph ph-seal-check"></i> Válido en oposiciones</span>
        <span class="cta-final__pill"><i class="ph ph-clock"></i> {data.hours} horas · 100% online</span>
      </div>
    </div>
  </section>

  <!-- ── STICKY BAR ────────────────────────────────────────────────────── -->
  <div class="sticky-bar is-hidden" id="stickyBar">
    <div class="sticky-bar__inner">
      <div class="sticky-bar__info">
        <span class="sticky-bar__title">{data.title}</span>
        <div class="sticky-bar__meta">
          <span><i class="ph ph-clock"></i> {data.hours} h</span>
          <span><i class="ph ph-graduation-cap"></i> {data.ects} ECTS</span>
          <span><i class="ph ph-laptop"></i> Online</span>
          <span><i class="ph ph-seal-check"></i> Válido en oposiciones</span>
        </div>
      </div>
      <div class="sticky-bar__right">
        <span class="sticky-bar__price">{data.price} €</span>
        <a href={ctaHref} class="btn btn--primary btn--sm">
          <i class="ph ph-lock-key"></i> Matricúlate
        </a>
      </div>
    </div>
  </div>

  <!-- ── STYLES ────────────────────────────────────────────────────────── -->
  <style>
    /* ── HERO ── */
    .hero {
      background: var(--navy);
      padding: 150px 0 72px;
      position: relative; overflow: hidden;

    }
    .hero-blob { position: absolute; border-radius: 50%; filter: blur(100px); pointer-events: none; z-index: 0; }
    .hero-blob-1 { width: 600px; height: 600px; background: var(--sky); opacity: .22; top: -220px; right: -120px; }
    .hero-blob-2 { width: 420px; height: 420px; background: var(--blue); opacity: .28; bottom: -120px; left: 18%; }

    .hero__inner {
      display: grid; grid-template-columns: 1fr 340px;
      gap: 56px; align-items: center; position: relative; z-index: 1;
    }
    .hero__breadcrumb {
      display: flex; align-items: center; gap: 8px;
      font-size: .78rem; color: rgba(255,255,255,.45); margin-bottom: 18px;
      flex-wrap: wrap;
    }
    .hero__breadcrumb a { color: rgba(255,255,255,.45); transition: color .2s; }
    .hero__breadcrumb a:hover { color: var(--sky); }
    .hero__breadcrumb span { color: rgba(255,255,255,.7); }
    .hero__tags  { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
    .hero__title { color: var(--white); margin-bottom: 18px; }
    .hero__subtitle {
      font-size: 1rem; color: rgba(255,255,255,.72);
      line-height: 1.75; margin-bottom: 28px; max-width: 560px;
    }
    .hero__pills {
      display: flex; flex-wrap: wrap; gap: 20px;
      margin-top: 24px; padding-top: 24px;
      border-top: 1px solid rgba(255,255,255,.1);
    }
    .hero__pill {
      display: flex; align-items: center; gap: 7px;
      font-size: .82rem; color: rgba(255,255,255,.78); font-weight: 500;
    }
    .hero__pill i { color: var(--sky); font-size: 1rem; }

    /* Course Card */
    .course-card {
      background: var(--white); border-radius: 20px;
      overflow: hidden; box-shadow: var(--shadow-lg);
      transition: box-shadow .3s;
    }
    .course-card:hover { box-shadow: 0 16px 56px rgba(19,16,59,.22); }
    .course-card__img {
      width: 100%; height: 172px;
      background: linear-gradient(135deg, var(--blue) 0%, var(--sky) 100%);
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden;
    }
    .course-card__img-icon { font-size: 4rem; color: rgba(255,255,255,.2); }
    .course-card__img-text {
      position: absolute; bottom: 14px; left: 16px;
      font-size: .68rem; font-weight: 600;
      color: rgba(255,255,255,.55); letter-spacing: .07em; text-transform: uppercase;
    }
    .course-card__body { padding: 22px; }
    .course-card__price { display: flex; align-items: baseline; gap: 6px; margin-bottom: 6px; }
    .course-card__amount { font-size: 2.4rem; font-weight: 800; color: var(--navy); }
    .course-card__currency { font-size: 1rem; font-weight: 600; color: var(--gray); }
    .course-card__pack-hint {
      font-size: .77rem; color: var(--sky); font-weight: 600;
      margin-bottom: 18px; display: flex; align-items: center; gap: 6px;
    }
    .course-card__meta {
      display: flex; flex-direction: column; gap: 9px;
      margin-bottom: 18px; padding-bottom: 18px;
      border-bottom: 1px solid var(--gray-light);
    }
    .course-card__meta-row { display: flex; align-items: center; gap: 9px; font-size: .82rem; color: var(--navy); font-weight: 500; }
    .course-card__meta-row i { color: var(--sky); font-size: .95rem; flex-shrink: 0; }
    .course-card__cta { display: flex; flex-direction: column; gap: 9px; }

    /* ── SHARED ── */
    .section-label {
      display: inline-block; font-size: .72rem; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase;
      color: var(--sky); margin-bottom: 10px;
    }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 14px 28px; border-radius: 999px;
      font-family: 'Poppins', sans-serif; font-weight: 700; font-size: .93rem;
      border: none; cursor: pointer;
      transition: transform .2s, box-shadow .2s, opacity .2s;
      text-decoration: none;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn--primary { background: var(--blue); color: var(--white); box-shadow: 0 4px 20px rgba(36,36,186,.35); }
    .btn--primary:hover { box-shadow: 0 8px 32px rgba(36,36,186,.45); }
    .btn--sky { background: var(--sky); color: var(--white); box-shadow: 0 4px 20px rgba(41,171,226,.35); }
    .btn--sky:hover { box-shadow: 0 8px 32px rgba(41,171,226,.45); }
    .btn--outline-white { background: transparent; color: var(--white); border: 2px solid rgba(255,255,255,.45); }
    .btn--outline-white:hover { border-color: var(--white); background: rgba(255,255,255,.08); }
    .btn--ghost { background: rgba(19,16,59,.07); color: var(--navy); }
    .btn--ghost:hover { background: rgba(19,16,59,.12); }
    .btn--lg { padding: 18px 40px; font-size: 1.05rem; }
    .btn--sm { padding: 10px 22px; font-size: .85rem; }
    .btn--full { width: 100%; justify-content: center; }

    .tag {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 14px; border-radius: 999px; font-size: .76rem; font-weight: 600;
    }
    .tag--sky   { background: rgba(41,171,226,.14); color: var(--sky); }
    .tag--white { background: rgba(255,255,255,.14); color: rgba(255,255,255,.9); }

    /* ── INTRO ── */
    .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
    .intro-content { line-height: 1.75; }
    .intro-content p { color: var(--gray); margin-bottom: 12px; }
    .intro__list { display: flex; flex-direction: column; gap: 12px; margin-top: 0; }
    .intro__item {
      display: flex; gap: 14px; align-items: flex-start;
      padding: 16px 18px; background: var(--white);
      border-radius: var(--radius); box-shadow: var(--shadow-sm);
      transition: box-shadow .2s, transform .2s;
    }
    .intro__item:hover { box-shadow: var(--shadow-md); transform: translateX(3px); }
    .intro__item-icon {
      width: 36px; height: 36px; flex-shrink: 0;
      background: rgba(41,171,226,.1); border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      color: var(--sky); font-size: 1rem;
    }
    .intro__item p { font-size: .87rem; line-height: 1.65; color: var(--navy); margin: 0; }

    /* ── STATS ── */
    .section-stats { padding: 52px 0; background: var(--white); }
    .stats-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }
    .stat-card {
      background: var(--white); border: 1px solid rgba(19,16,59,.08);
      border-radius: var(--radius); padding: 28px 20px; text-align: center;
      box-shadow: var(--shadow-sm); position: relative; overflow: hidden;
      transition: box-shadow .3s, border-color .3s, transform .2s;
    }
    .stat-card:hover { border-color: rgba(41,171,226,.25); box-shadow: 0 8px 28px rgba(41,171,226,.12); transform: translateY(-2px); }
    .stat-icon { font-size: 1.7rem; color: var(--sky); margin-bottom: 8px; display: block; }
    .stat-value { font-size: 1.5rem; font-weight: 800; color: var(--blue); }
    .stat-label { font-size: .78rem; color: var(--gray); margin-top: 4px; }

    /* ── PROGRAMA / ACORDEÓN ── */
    .programa-header {
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 24px; margin-bottom: 36px; flex-wrap: wrap;
    }
    .programa-count {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(41,171,226,.1); border-radius: 999px; padding: 8px 20px;
      font-size: .82rem; font-weight: 600; color: var(--sky); white-space: nowrap;
    }
    .acordeon { display: flex; flex-direction: column; gap: 10px; }
    .acordeon__item {
      background: var(--white); border: 1.5px solid rgba(19,16,59,.09);
      border-radius: var(--radius); overflow: hidden;
      position: relative; transition: border-color .25s, box-shadow .25s;
    }
    .acordeon__item.is-open { border-color: rgba(41,171,226,.35); box-shadow: 0 4px 18px rgba(41,171,226,.09); }
    .acordeon__header {
      display: flex; align-items: center; gap: 14px;
      padding: 20px 22px; cursor: pointer; user-select: none; transition: background .2s;
    }
    .acordeon__header:hover { background: rgba(240,246,255,.7); }
    .acordeon__num {
      width: 32px; height: 32px; flex-shrink: 0;
      background: var(--cream); border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: .76rem; font-weight: 700; color: var(--blue); transition: background .2s, color .2s;
    }
    .acordeon__item.is-open .acordeon__num { background: var(--blue); color: var(--white); }
    .acordeon__title { flex: 1; font-size: .93rem; font-weight: 600; color: var(--navy); }
    .acordeon__chevron {
      width: 30px; height: 30px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      background: rgba(41,171,226,.1); border-radius: 50%;
      color: var(--sky); font-size: .85rem;
      transition: transform .3s, background .25s, color .25s;
    }
    .acordeon__item.is-open .acordeon__chevron {
      transform: rotate(180deg);
      background: linear-gradient(135deg, var(--blue), var(--sky));
      color: var(--white);
    }
    .acordeon__body { max-height: 0; overflow: hidden; transition: max-height .38s ease; }
    .acordeon__body-inner {
      padding: 16px 22px 20px 68px;
      font-size: .87rem; color: var(--gray); line-height: 1.75;
      background: rgba(240,246,255,.5);
      border-top: 1px solid rgba(41,171,226,.15);
    }

    /* ── AUDIENCIA ── */
    .audience-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 14px; margin-top: 40px; }
    .audience-card {
      display: flex; align-items: flex-start; gap: 14px;
      padding: 18px 20px; background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,255,255,.12); border-radius: var(--radius);
      transition: background .2s, border-color .2s, transform .2s;
    }
    .audience-card:hover { background: rgba(255,255,255,.11); border-color: rgba(41,171,226,.45); transform: translateY(-2px); }
    .audience-card__icon {
      width: 42px; height: 42px; flex-shrink: 0;
      background: rgba(41,171,226,.18); border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      color: var(--sky); font-size: 1.2rem;
    }
    .audience-card__title { font-size: .88rem; font-weight: 700; color: var(--white); margin-bottom: 3px; }
    .audience-card__desc  { font-size: .81rem; color: rgba(255,255,255,.65); line-height: 1.5; }

    /* ── LOGROS ── */
    .logros-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
    .logros-list { display: flex; flex-direction: column; gap: 12px; }
    .logro-item {
      display: flex; gap: 14px; align-items: flex-start;
      padding: 16px 18px; border-radius: var(--radius);
      background: var(--white); box-shadow: var(--shadow-sm);
      transition: box-shadow .2s, transform .2s;
    }
    .logro-item:hover { box-shadow: var(--shadow-md); transform: translateX(4px); }
    .logro-item__check {
      width: 26px; height: 26px; flex-shrink: 0;
      background: rgba(41,171,226,.12); border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      color: var(--sky); font-size: .85rem; margin-top: 2px;
    }
    .logro-item p { font-size: .87rem; line-height: 1.65; color: var(--navy); margin: 0; }

    /* ── EVALUATION CARDS V2 ── */
    .evaluation-cards-v2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin-top: 32px;
    }
    .evaluation-card-v2 {
      display: flex;
      gap: 20px;
      align-items: flex-start;
      padding: 24px;
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      border: 1.5px solid rgba(19,16,59,.08);
      transition: all .3s cubic-bezier(.4,0,.2,1);
    }
    .evaluation-card-v2:hover {
      border-color: rgba(41,171,226,.25);
      box-shadow: 0 4px 16px rgba(41,171,226,.1);
    }
    .evaluation-icon-v2 {
      flex-shrink: 0;
      width: 48px;
      height: 48px;
      background: linear-gradient(135deg, var(--blue), var(--sky));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: var(--white);
    }
    .evaluation-card-v2 h3 {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--navy);
      margin-bottom: 8px;
    }
    .evaluation-card-v2 p {
      color: var(--gray);
      line-height: 1.7;
      font-size: .9rem;
      margin: 0;
    }

    /* ── PROFESOR ── */
    .profesor-card {
      display: flex; gap: 48px; align-items: center;
      background: var(--white); border-radius: 20px;
      padding: 40px; box-shadow: var(--shadow-md);
      max-width: 860px; margin: 40px auto 0;
      border: 1px solid rgba(19,16,59,.06);
    }
    .profesor-photo-col {
      flex-shrink: 0;
      display: flex; flex-direction: column;
      align-items: center; gap: 16px;
    }
    .profesor-photo-ring {
      width: 200px; height: 200px;
      border-radius: 50%; padding: 5px;
      background: linear-gradient(135deg, var(--blue), var(--sky));
      box-shadow: 0 8px 32px rgba(41,171,226,.3);
    }
    .profesor-photo {
      width: 100%; height: 100%;
      border-radius: 50%; object-fit: cover;
      border: 4px solid var(--white); display: block;
    }
    .profesor-photo-placeholder {
      width: 100%; height: 100%;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--navy), var(--blue));
      border: 4px solid var(--white);
      display: flex; align-items: center; justify-content: center;
      font-size: 3.5rem; color: rgba(255,255,255,.4);
    }
    .profesor-badge-row { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
    .profesor-badge {
      display: inline-flex; align-items: center; gap: 5px;
      background: var(--cream); color: var(--navy);
      border-radius: 999px; padding: 4px 12px;
      font-size: .73rem; font-weight: 600;
    }
    .profesor-badge i { color: var(--sky); }
    .profesor-card__name { font-size: 1.4rem; font-weight: 800; margin-bottom: 4px; }
    .profesor-card__role { font-size: .9rem; font-weight: 600; color: var(--sky); margin-bottom: 16px; }
    .profesor-card__bio  { font-size: .87rem; color: var(--gray); line-height: 1.75; margin: 0; }

    /* ── PACK ── */
    .pack-card {
      background: var(--cream); border: 1.5px solid rgba(41,171,226,.25);
      border-radius: 20px; padding: 48px;
      position: relative; overflow: hidden;
    }
    .pack-card::after {
      content: ''; position: absolute; top: 0; right: 0;
      width: 300px; height: 300px;
      background: radial-gradient(circle, rgba(41,171,226,.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .pack-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: linear-gradient(90deg, var(--blue), var(--sky));
      color: var(--white); font-size: .76rem; font-weight: 700;
      letter-spacing: .06em; text-transform: uppercase;
      padding: 6px 16px; border-radius: 999px; margin-bottom: 20px;
    }
    .pack-prices { display: flex; align-items: baseline; gap: 12px; margin: 16px 0 4px; flex-wrap: wrap; }
    .pack-prices__main { font-size: 3rem; font-weight: 800; color: var(--navy); }
    .pack-prices__old { font-size: 1.3rem; font-weight: 600; color: var(--gray); text-decoration: line-through; }
    .pack-prices__saving { font-size: .82rem; font-weight: 700; color: var(--sky); background: rgba(41,171,226,.15); padding: 4px 12px; border-radius: 999px; }
    .pack-rules { display: flex; flex-direction: column; gap: 10px; margin: 22px 0; }
    .pack-rule { display: flex; align-items: center; gap: 10px; font-size: .87rem; color: var(--navy); }
    .pack-rule i { color: var(--sky); font-size: 1rem; flex-shrink: 0; }
    .pack-btns { display: flex; gap: 12px; flex-wrap: wrap; }

    /* ── CERTIFICADO ── */
    .cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
    .cert-visual {
      background: var(--white); border-radius: 20px;
      padding: 40px; box-shadow: var(--shadow-md);
      text-align: center; position: relative; overflow: hidden;
      box-shadow:
          0 8px 32px rgba(0, 0, 0, 0.1),
          inset 0 1px 0 rgba(255, 255, 255, 0.5),
          inset 0 -1px 0 rgba(255, 255, 255, 0.1),
          inset 0 0 20px 10px rgba(255, 255, 255, 1);
    }
    .cert-visual::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg, var(--blue), var(--sky));
    }
    .cert-logo-img { width: 160px; margin: 0 auto 16px; border-radius: 8px;     border: 1px solid;
      border-color: #f1f2fa;}
    .cert-visual h4  { font-size: .9rem; font-weight: 700; }
    .cert-visual p   { font-size: .78rem; color: var(--gray); margin-top: 4px; }
    .cert-visual__seal {
      margin-top: 20px; display: inline-flex; align-items: center; gap: 8px;
      font-size: .74rem; color: var(--blue); font-weight: 600;
      background: rgba(36,36,186,.07); padding: 8px 16px; border-radius: 999px;
    }
    .cert-list { display: flex; flex-direction: column; gap: 22px; }
    .cert-item  { display: flex; gap: 14px; align-items: flex-start; }
    .cert-item__icon {
      width: 42px; height: 42px; flex-shrink: 0;
      background: rgba(41,171,226,.1); border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      color: var(--sky); font-size: 1.1rem;
    }
    .cert-item__title { font-size: .9rem; font-weight: 700; margin-bottom: 4px; }
    .cert-item__desc  { font-size: .83rem; color: var(--gray); line-height: 1.65; margin: 0; }

    /* ── FAQ ── */
    .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .faq-item {
      border: 1.5px solid var(--gray-light);
      border-radius: var(--radius); overflow: hidden;
      transition: border-color .2s, box-shadow .2s;
    }
    .faq-item.is-open {
      border-color: rgba(41,171,226,.45);
      border-left: 3px solid var(--sky);
      box-shadow: 0 4px 16px rgba(41,171,226,.1);
    }
    .faq-header {
      display: flex; align-items: center; gap: 10px;
      padding: 16px 18px; cursor: pointer; user-select: none;
      background: var(--white); transition: background .2s;
    }
    .faq-item.is-open .faq-header {
      background: rgba(41,171,226,.06);
      border-bottom: 1px solid rgba(41,171,226,.2);
    }
    .faq-header:hover { background: var(--cream); }
    .faq-question { flex: 1; font-size: .85rem; font-weight: 600; line-height: 1.4; }
    .faq-chevron  { color: var(--gray); font-size: .85rem; transition: transform .3s; flex-shrink: 0; }
    .faq-item.is-open .faq-chevron { transform: rotate(180deg); color: var(--sky); }
    .faq-body { max-height: 0; overflow: hidden; transition: max-height .38s ease; }
    .faq-body-inner {
      padding: 16px 18px 18px;
      font-size: .83rem; color: var(--gray); line-height: 1.7;
      background: rgba(240,246,255,.5);
    }

    /* ── CTA FINAL ── */
    .cta-final {
      background: var(--navy); padding: 96px 0;
      text-align: center; position: relative; overflow: hidden;
    }
    .cta-final::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 60% 100% at 50% 0%, rgba(36,36,186,.5) 0%, transparent 70%);
    }
    .cta-final .container { position: relative; z-index: 1; }
    .cta-final__title {
      font-size: clamp(1.7rem, 4vw, 2.6rem); font-weight: 800;
      color: var(--white); margin-bottom: 14px;
    }
    .cta-final__sub {
      font-size: .97rem; color: rgba(255,255,255,.68);
      margin-bottom: 36px; max-width: 500px; margin-inline: auto;
    }
    .cta-final__btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-bottom: 36px; }
    .cta-final__pills { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; }
    .cta-final__pill { display: flex; align-items: center; gap: 7px; font-size: .8rem; color: rgba(255,255,255,.65); }
    .cta-final__pill i { color: var(--sky); }

    /* ── STICKY BAR ── */
    .sticky-bar {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: rgba(255,255,255,.96);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--gray-light);
      box-shadow: 0 -4px 24px rgba(19,16,59,.1);
      z-index: 200; transition: transform .3s;
    }
    .sticky-bar.is-hidden { transform: translateY(100%); }
    .sticky-bar__inner {
      max-width: 1180px; margin: 0 auto; padding: 12px 24px;
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
    }
    .sticky-bar__info { display: flex; flex-direction: column; min-width: 0; }
    .sticky-bar__title { font-size: .86rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sticky-bar__meta { font-size: .73rem; color: var(--gray); display: flex; gap: 12px; flex-wrap: wrap; margin-top: 2px; }
    .sticky-bar__right { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
    .sticky-bar__price { font-size: 1.5rem; font-weight: 800; }

    /* ── SHARED LAYOUT ── */
    .section { padding: 88px 0; }
    .section--cream { background: var(--cream); }
    .section--light { background: var(--light); }
    .section--navy  { background: var(--navy); color: var(--white); }
    .section--white { background: var(--white); }
    .container { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
    .lead { font-size: 1rem; color: var(--gray); line-height: 1.75; }
    .h1 { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; line-height: 1.15; }
    .h2 { font-size: clamp(1.6rem, 3.5vw, 2.3rem); font-weight: 800; line-height: 1.2; }
    .h3 { font-size: 1.1rem; font-weight: 700; }
    .shadow-sm { box-shadow: var(--shadow-sm); }
    .shadow-md { box-shadow: var(--shadow-md); }

    /* ── RESPONSIVE 960px ── */
    @media (max-width: 960px) {
      .hero__inner       { grid-template-columns: 1fr; gap: 36px; }
      .course-card       { max-width: 440px; }
      .intro-grid        { grid-template-columns: 1fr; gap: 36px; }
      .stats-grid        { grid-template-columns: repeat(2,1fr); gap: 14px; }
      .logros-two-col    { grid-template-columns: 1fr; gap: 32px; }
      .steps-grid        { grid-template-columns: 1fr; }
      .evaluation-cards-v2 { grid-template-columns: 1fr; }
      .cert-grid         { grid-template-columns: 1fr; gap: 36px; }
      .faq-grid          { grid-template-columns: 1fr; }
      .audience-grid     { grid-template-columns: 1fr; }
      .profesor-card     { flex-direction: column; align-items: center; text-align: center; padding: 32px; gap: 28px; }
      .profesor-photo-ring { width: 160px; height: 160px; }
      .profesor-badge-row  { justify-content: center; }
      .section           { padding: 64px 0; }
      .pack-card         { padding: 28px; }
    }

    /* ── RESPONSIVE 600px ── */
    @media (max-width: 600px) {
      .hero { padding: 72px 0 56px; }
      .hero__breadcrumb { display: none; }
      .hero__subtitle { font-size: .93rem; }
      .hero__pills { gap: 14px; }
      .hero__pill  { font-size: .78rem; }

      .stats-grid { grid-template-columns: repeat(2,1fr); gap: 10px; }
      .stat-card  { padding: 18px 12px; }
      .stat-icon  { font-size: 1.4rem; }
      .stat-value { font-size: 1.25rem; }
      .stat-label { font-size: .74rem; }

      .acordeon__header       { padding: 16px; gap: 10px; }
      .acordeon__title        { font-size: .87rem; }
      .acordeon__body-inner   { padding: 0 16px 16px 58px; }

      .logros-list   { gap: 10px; }
      .logro-item    { padding: 14px 16px; }
      .logro-item p  { font-size: .84rem; }

      .step-card     { padding: 16px; gap: 14px; }
      .step-num      { width: 36px; height: 36px; font-size: 1rem; }

      .profesor-card { padding: 24px 20px; gap: 20px; }
      .profesor-photo-ring { width: 140px; height: 140px; }

      .pack-card  { padding: 22px 18px; }
      .pack-prices__main { font-size: 2.2rem; }
      .pack-btns  { flex-direction: column; }
      .pack-btns .btn { justify-content: center; }

      .cert-grid  { gap: 28px; }

      .faq-header   { padding: 14px 16px; }
      .faq-question { font-size: .82rem; }

      .cta-final   { padding: 64px 0; }
      .cta-final__btns { flex-direction: column; align-items: stretch; }
      .cta-final__btns .btn { justify-content: center; }
      .cta-final__pills { gap: 12px; }

      .sticky-bar__meta { display: none; }
      .sticky-bar__price { font-size: 1.3rem; }
    }
  </style>

  <!-- ── SCRIPTS ───────────────────────────────────────────────────────── -->
  <script>
    /* Acordeón */
    document.querySelectorAll('.acordeon__header').forEach(header => {
      header.addEventListener('click', () => {
        const item = header.parentElement as HTMLElement;
        const body = item.querySelector('.acordeon__body') as HTMLElement;
        const isOpen = item.classList.contains('is-open');
        document.querySelectorAll('.acordeon__item').forEach(i => {
          i.classList.remove('is-open');
          (i.querySelector('.acordeon__body') as HTMLElement).style.maxHeight = '0';
        });
        if (!isOpen) {
          item.classList.add('is-open');
          body.style.maxHeight = body.scrollHeight + 40 + 'px';
        }
      });
    });

    /* FAQ */
    document.querySelectorAll('.faq-header').forEach(header => {
      header.addEventListener('click', () => {
        const item = header.parentElement as HTMLElement;
        const body = item.querySelector('.faq-body') as HTMLElement;
        const isOpen = item.classList.contains('is-open');
        item.classList.toggle('is-open', !isOpen);
        body.style.maxHeight = isOpen ? '0' : body.scrollHeight + 'px';
      });
    });

    /* Sticky bar */
    const hero = document.getElementById('top');
    const stickyBar = document.getElementById('stickyBar');
    if (hero && stickyBar) {
      const obs = new IntersectionObserver(([e]) => {
        stickyBar.classList.toggle('is-hidden', e.isIntersecting);
      }, { threshold: 0 });
      obs.observe(hero);
    }
  </script>

</BaseLayout>
