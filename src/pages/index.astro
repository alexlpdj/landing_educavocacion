---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import CourseCard from '../components/CourseCard.astro';
import { courseImageMap } from '../data/courseImages';
import heroBgImg from '../assets/img/hero-bg.jpg';
import nosotrosImg from '../assets/img/nosotros_image.jpg';

const courses = await getCollection('cursos');

// Optimize hero background
const heroOptimized = await getImage({ src: heroBgImg });
---

<BaseLayout
  title="EducaVocación – Formación para oposiciones docentes"
  description="Cursos homologados para oposiciones, preparación personalizada y creación de temarios con docentes en activo que conocen el proceso desde dentro."
  showWhatsApp={true}
>

<!-- HERO -->
<section id="hero" style={`background-image: url('${heroOptimized.src}')`}>
  <div class="hero-overlay"></div>
  <div class="hero-blob hero-blob-1"></div>
  <div class="hero-blob hero-blob-2"></div>
  <div class="container">
    <div class="hero-inner">
      <div>
        <div class="hero-eyebrow">
          <span></span>
          Formación para docentes
        </div>
        <h1 class="hero-title">
          Prepárate para tu <em>plaza docente</em> con formación que realmente suma puntos
        </h1>
        <p class="hero-sub">
          Cursos homologados para oposiciones, preparación personalizada y creación de temarios con docentes en activo que conocen el proceso desde dentro.
        </p>
        <div class="hero-btns">
          <a href="/cursos/" class="btn btn--primary">Ver cursos homologados</a>
          <a href="#contacto" class="btn btn--outline-white">Solicitar información</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CONFIANZA -->
<section id="confianza" class="section section--cream">
  <div class="container">
    <div class="trust-grid fade-in">
      <div class="trust-text">
        <span class="tag">¿Por qué elegirnos?</span>
        <h2 class="h2">Formación creada por docentes que han vivido el proceso de oposiciones</h2>
        <p>En <strong>EDUCAVOCACIÓN</strong> trabajamos para ayudarte a alcanzar tu plaza docente con una formación práctica, actualizada y diseñada por profesionales que conocen el sistema educativo desde dentro.</p>
        <p>Creemos que la educación tiene el poder de transformar vidas, y por eso ofrecemos programas formativos orientados a resultados reales.</p>
        <p>Acompañamos a cada alumno durante su proceso de preparación con herramientas, metodología y asesoramiento personalizado.</p>
        <p style="font-weight:700; color: var(--blue); margin-top:8px;">Nuestro objetivo es que llegues al examen con seguridad, preparación y confianza.</p>
      </div>
      <div class="trust-cards">
        <div class="trust-card fade-in fade-delay-1">
          <div class="trust-card-icon"><i class="ph ph-clipboard-text"></i></div>
          <div>
            <h4>Contenido actualizado</h4>
            <p>Todos nuestros materiales se adaptan a la normativa educativa vigente para cada convocatoria.</p>
          </div>
        </div>
        <div class="trust-card fade-in fade-delay-2">
          <div class="trust-card-icon"><i class="ph ph-graduation-cap"></i></div>
          <div>
            <h4>Equipo de docentes en activo</h4>
            <p>Nuestros formadores son profesionales del sistema educativo con experiencia real en oposiciones.</p>
          </div>
        </div>
        <div class="trust-card fade-in fade-delay-3">
          <div class="trust-card-icon"><i class="ph ph-target"></i></div>
          <div>
            <h4>Orientado a resultados</h4>
            <p>Todo lo que aprenderás tiene un impacto directo en tu baremo y en tu preparación para el examen.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CURSOS -->
<section id="cursos" class="section">
  <div class="container">
    <div class="cursos-header fade-in">
      <span class="tag">Cursos homologados</span>
      <h2 class="h2">Cursos homologados para oposiciones docentes</h2>
      <p>¿Estás pensando en opositar al cuerpo docente en cualquier comunidad autónoma de España? Nuestros cursos están homologados y son válidos para el baremo de méritos en oposiciones al cuerpo de maestros y profesorado.</p>
    </div>
    <div class="cursos-modern-grid" id="cursos-grid">
      <!-- Navy aside card -->
      <div class="cursos-aside fade-in">
        <span class="tag" style="color:var(--sky); background:rgba(41,171,226,.15);">Todos nuestros programas están</span>
        <ul class="check-list">
          <li>Actualizados según la normativa educativa</li>
          <li>Diseñados por docentes en activo</li>
          <li>Orientados a sumar puntos en la oposición</li>
        </ul>
        <p>Además, están pensados para que puedas realizarlos con flexibilidad mientras preparas tus oposiciones.</p>
        <a href="/cursos/" class="btn btn--sky">Ver cursos disponibles</a>
      </div>

      {courses.slice(0, 5).map((course, i) => (
        <CourseCard
          slug={course.slug}
          title={course.data.title}
          description={course.data.description}
          hours={course.data.hours}
          ects={course.data.ects}
          price={course.data.price}
          icon={course.data.icon}
          image={courseImageMap[course.slug] || course.data.image}
          packEligible={course.data.packEligible}
          animClass={`fade-in${i > 0 ? ` fade-delay-${Math.min(i, 3)}` : ''}`}
        />
      ))}
      {courses.length === 0 && (
        <div class="curso-card-modern fade-in" style="text-decoration:none;">
          <div class="curso-card-top">
            <div class="curso-card-icon-wrap"><i class="ph ph-books"></i></div>
          </div>
          <div style="padding:28px;">
            <div style="font-size:1.05rem; font-weight:700; margin-bottom:8px; color:var(--navy);">Nuevos cursos en preparación</div>
            <div style="font-size:.86rem; color:var(--gray); line-height:1.65;">Estamos preparando más formaciones homologadas para oposiciones. Contáctanos para más información.</div>
          </div>
        </div>
      )}
    </div>
    <div style="text-align:center; margin-top:40px;">
      <a href="/cursos/" class="btn btn--sky">Ver todos los cursos <i class="ph ph-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- SERVICIOS -->
<section id="servicios" class="section section--navy">
  <div class="container">
    <div class="servicios-intro fade-in">
      <span class="tag" style="color:var(--sky); background:rgba(41,171,226,.15);">Nuestros servicios</span>
      <h2 class="h2" style="color:var(--white);">Te acompañamos en todo el proceso de oposición</h2>
      <p>Sabemos que preparar una oposición puede ser un camino complejo. Por eso ofrecemos diferentes servicios para ayudarte en cada etapa del proceso.</p>
    </div>
    <div class="servicios-grid">
      <div class="servicio-card fade-in fade-delay-1">
        <div class="servicio-icon"><i class="ph ph-book-open"></i></div>
        <h3>Preparación de oposiciones</h3>
        <p>Si estás preparando una oposición y necesitas orientación profesional, podemos ayudarte. Ofrecemos acompañamiento, preparación específica y formación homologada para tu baremo.</p>
        <p>Nuestro equipo está formado por:</p>
        <ul class="check-list">
          <li>Docentes en activo en diferentes etapas educativas</li>
          <li>Preparadores de oposiciones</li>
          <li>Funcionariado y personal de Administraciones Públicas</li>
          <li>Miembros de tribunales de oposiciones</li>
        </ul>
        <a href="/servicios/preparacion-oposiciones/" class="btn btn--outline-white btn--sm">Saber más <i class="ph ph-arrow-right"></i></a>
      </div>
      <div class="servicio-card fade-in fade-delay-2">
        <div class="servicio-icon"><i class="ph ph-pencil-line"></i></div>
        <h3>Creación de temarios para oposiciones</h3>
        <p>Si necesitas ayuda en la elaboración de tu temario, podemos ayudarte a desarrollarlo con criterios profesionales y adaptados a cada convocatoria.</p>
        <p>Nuestro equipo te ayudará a crear un temario sólido, estructurado y alineado con lo que realmente valoran los tribunales.</p>
        <p>Cuéntanos qué oposición estás preparando y te enviaremos un presupuesto personalizado sin compromiso.</p>
        <a href="/servicios/creacion-temarios/" class="btn btn--outline-white btn--sm">Saber más <i class="ph ph-arrow-right"></i></a>
      </div>
    </div>
  </div>
</section>

<!-- SOBRE NOSOTROS -->
<section id="nosotros" class="section section--light">
  <div class="container">
    <div class="about-wrap">
      <div class="about-visual fade-in">
        <div class="about-img-wrap">
          <Image src={nosotrosImg} alt="Equipo EducaVocación" />
        </div>
        <div class="about-badge">
          <strong>100%</strong>
          Calidad garantizada
        </div>
      </div>
      <div class="about-text fade-in fade-delay-1">
        <span class="tag">Sobre nosotros</span>
        <h2 class="h2">Somos EDUCAVOCACIÓN</h2>
        <p>Somos una entidad dedicada a impulsar el crecimiento personal y profesional a través de programas de formación innovadores y accesibles.</p>
        <p>Nuestra misión es facilitar el acceso a una formación de calidad que permita a personas y profesionales desarrollar nuevas competencias y alcanzar sus metas.</p>
        <div class="about-values">
          <div class="about-value">
            <div class="about-value-dot" style="background:rgba(36,36,186,.1);"><i class="ph ph-trophy" style="color:var(--blue);"></i></div>
            <div><h5>Excelencia educativa</h5></div>
          </div>
          <div class="about-value">
            <div class="about-value-dot" style="background:rgba(41,171,226,.1);"><i class="ph ph-lightbulb" style="color:var(--sky);"></i></div>
            <div><h5>Innovación en la formación</h5></div>
          </div>
          <div class="about-value">
            <div class="about-value-dot" style="background:rgba(19,16,59,.06);"><i class="ph ph-book" style="color:var(--navy);"></i></div>
            <div><h5>Aprendizaje permanente</h5></div>
          </div>
        </div>
        <p style="font-weight:600; color:var(--blue);">Trabajamos con pasión para que cada estudiante construya un camino sólido hacia su futuro profesional.</p>
      </div>
    </div>
  </div>
</section>

<ContactForm
  title="Cuéntanos en qué podemos ayudarte"
  subtitle="Si estás preparando oposiciones y necesitas información sobre nuestros cursos o servicios, estaremos encantados de ayudarte."
/>

<style>
    /* ─── HERO ─── */
    #hero {
      min-height: 100vh;
      display: flex; align-items: center;
      padding-top: 68px;
      background: var(--navy);
      position: relative;
      overflow: hidden;
      background-size: cover;
      background-position: center top;
    }
    .hero-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: .35;
      pointer-events: none;
    }
    .hero-blob-1 {
      width: 600px; height: 600px;
      background: var(--sky);
      top: -150px; right: -150px;
    }
    .hero-blob-2 {
      width: 400px; height: 400px;
      background: var(--blue);
      bottom: -100px; left: 40%;
    }
    .hero-inner {
      position: relative; z-index: 2;
      display: grid; grid-template-columns: 1fr;
      gap: 64px; align-items: center;
      padding: 100px 0 100px;
      max-width: 680px;
    }
    .hero-eyebrow {
      display: flex; align-items: center; gap: 10px;
      font-size: .82rem; font-weight: 600;
      color: var(--sky); margin-bottom: 22px;
    }
    .hero-eyebrow span { height: 2px; width: 32px; background: var(--sky); border-radius: 2px; }
    .hero-title { font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 800; line-height: 1.1; margin-bottom: 22px; color: var(--white); }
    .hero-title em { font-style: normal; color: var(--sky); }
    .hero-sub { font-size: 1.05rem; line-height: 1.75; color: rgba(255,255,255,.85); margin-bottom: 36px; max-width: 500px; }
    .hero-btns { display: flex; flex-wrap: wrap; gap: 14px; }
    .hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(100deg, rgba(19,16,59,.90) 0%, rgba(19,16,59,.75) 45%, rgba(19,16,59,.20) 100%);
      z-index: 1;
    }
    .hero-inner { position: relative; z-index: 2; max-width: 55%; }

    /* ─── TRUST ─── */
    .trust-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 80px; align-items: center;
    }
    .trust-text .h2 { margin-bottom: 24px; }
    .trust-text p   { color: var(--gray); line-height: 1.8; margin-bottom: 16px; }
    .trust-text strong { color: var(--blue); }
    .trust-cards { display: flex; flex-direction: column; gap: 16px; }
    .trust-card {
      background: var(--white);
      border: 1px solid rgba(19,16,59,.08);
      border-radius: var(--radius);
      padding: 24px;
      display: flex; gap: 18px; align-items: flex-start;
      transition: box-shadow .25s, transform .25s;
    }
    .trust-card:hover { box-shadow: 0 16px 40px rgba(19,16,59,.09); transform: translateY(-2px); }
    .trust-card-icon {
      flex-shrink: 0;
      width: 46px; height: 46px;
      background: var(--light);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
    }
    .trust-card-icon i { font-size: 22px; color: var(--navy); }
    .trust-card h4 { font-size: .95rem; font-weight: 700; margin-bottom: 4px; }
    .trust-card p  { font-size: .85rem; color: var(--gray); line-height: 1.5; }

    /* ─── CURSOS ─── */
    .cursos-header { text-align: center; max-width: 700px; margin: 0 auto 48px; }
    .cursos-header .h2 { margin-bottom: 18px; }
    .cursos-header p { color: var(--gray); line-height: 1.7; }
    .cursos-modern-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    /* ── Aside navy card ── */
    .cursos-aside {
      background: var(--navy);
      border-radius: 20px;
      padding: 36px 32px;
      color: var(--white);
      display: flex; flex-direction: column; gap: 0;
    }
    .cursos-aside .tag { margin-bottom: 24px; }
    .cursos-aside .check-list {
      list-style: none; display: flex; flex-direction: column; gap: 14px;
      margin-bottom: 20px;
    }
    .cursos-aside .check-list li {
      display: flex; align-items: flex-start; gap: 10px;
      font-size: .9rem; font-weight: 500; color: rgba(255,255,255,.9); line-height: 1.4;
    }
    .cursos-aside .check-list i { color: var(--sky); font-size: 1.15rem; flex-shrink: 0; margin-top: 1px; }
    .cursos-aside p {
      font-size: .85rem; color: rgba(255,255,255,.6); line-height: 1.65;
      margin-bottom: 28px;
    }

    /* ─── SERVICIOS ─── */
    .servicios-intro { text-align: center; max-width: 640px; margin: 0 auto 60px; }
    .servicios-intro .h2 { margin-bottom: 16px; }
    .servicios-intro p { color: rgba(255,255,255,.7); line-height: 1.7; }
    .servicios-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .servicio-card {
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 20px;
      padding: 40px;
      transition: background .25s, transform .25s;
    }
    .servicio-card:hover { background: rgba(255,255,255,.1); transform: translateY(-4px); }
    .servicio-icon {
      width: 56px; height: 56px;
      background: linear-gradient(135deg, var(--blue), var(--sky));
      border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 22px;
    }
    .servicio-icon i { font-size: 28px; color: #fff; }
    .servicio-card h3 { font-size: 1.2rem; font-weight: 800; margin-bottom: 14px; color: var(--white); }
    .servicio-card p  { font-size: .9rem; color: rgba(255,255,255,.65); line-height: 1.75; margin-bottom: 22px; }
    .servicio-card .check-list { margin-bottom: 28px; }
    .servicio-card .check-list li { color: rgba(255,255,255,.8); font-size: .88rem; }

    /* ─── SOBRE NOSOTROS ─── */
    .about-wrap {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 80px; align-items: center;
    }
    .about-text .h2 { margin-bottom: 10px; }
    .about-text .tag { margin-bottom: 12px; }
    .about-text p { color: var(--gray); line-height: 1.8; margin-bottom: 16px; }
    .about-values { display: flex; flex-direction: column; gap: 14px; margin: 28px 0; }
    .about-value {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 18px;
      background: var(--white);
      border: 1px solid rgba(19,16,59,.08);
      border-radius: var(--radius);
    }
    .about-value-dot {
      width: 36px; height: 36px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .about-value-dot i { font-size: 18px; }
    .about-value h5 { font-size: .9rem; font-weight: 700; }
    .about-visual { position: relative; }
    .about-img-wrap {
      border-radius: 24px; overflow: hidden;
      aspect-ratio: 4/5; position: relative;
    }
    .about-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .about-badge {
      position: absolute;
      bottom: -20px; right: -20px;
      background: var(--sky); color: var(--white);
      border-radius: 50%;
      width: 120px; height: 120px;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      font-weight: 800; font-size: .8rem; text-align: center;
      box-shadow: 0 10px 30px rgba(41,171,226,.4);
    }
    .about-badge strong { font-size: 2rem; display: block; }

    /* ─── CONTACTO ─── */
    .contact-wrap {
      display: grid; grid-template-columns: 1fr 1.5fr;
      gap: 64px; align-items: start;
    }
    .contact-info .h2 { margin-bottom: 18px; }
    .contact-info p  { color: var(--gray); line-height: 1.8; margin-bottom: 28px; }
    .contact-option {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 18px;
      border-radius: var(--radius);
      border: 1px solid rgba(19,16,59,.09);
      margin-bottom: 12px;
      transition: border-color .2s, box-shadow .2s;
      cursor: pointer;
    }
    .contact-option:hover { border-color: var(--sky); box-shadow: 0 4px 16px rgba(41,171,226,.12); }
    .contact-option-icon {
      width: 40px; height: 40px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .contact-option-icon i { font-size: 20px; }
    .contact-option h5 { font-size: .9rem; font-weight: 700; }
    .contact-option span { font-size: .8rem; color: var(--gray); }
    .form-card {
      background: var(--white);
      border: 1px solid rgba(19,16,59,.08);
      border-radius: 24px;
      padding: 40px;
      box-shadow: 0 20px 60px rgba(19,16,59,.07);
    }
    .form-card h3 { font-size: 1.15rem; font-weight: 800; margin-bottom: 6px; }
    .form-card p  { font-size: .85rem; color: var(--gray); margin-bottom: 28px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
    .form-group label { font-size: .82rem; font-weight: 600; color: var(--navy); }
    .form-group input,
    .form-group textarea {
      padding: 12px 16px;
      border: 1.5px solid rgba(19,16,59,.12);
      border-radius: 10px;
      font-family: 'Poppins', sans-serif;
      font-size: .9rem; color: var(--navy);
      background: #fafafa; outline: none;
      transition: border-color .2s, box-shadow .2s;
      width: 100%;
    }
    .form-group input:focus,
    .form-group textarea:focus {
      border-color: var(--sky);
      box-shadow: 0 0 0 3px rgba(41,171,226,.12);
      background: var(--white);
    }
    .form-group textarea { resize: vertical; min-height: 110px; }
    .form-submit {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, var(--blue), var(--sky));
      color: var(--white);
      font-family: 'Poppins', sans-serif;
      font-size: 1rem; font-weight: 700;
      border: none; border-radius: 999px;
      cursor: pointer;
      transition: opacity .2s, transform .2s;
      box-shadow: 0 8px 24px rgba(36,36,186,.3);
    }
    .form-submit:hover { opacity: .9; transform: translateY(-2px); }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 960px) {
      .hero-inner { max-width: 100%; }
      .trust-grid, .servicios-grid, .about-wrap, .contact-wrap {
        grid-template-columns: 1fr;
        gap: 40px;
      }
      .cursos-modern-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
      .form-row { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .cursos-modern-grid { grid-template-columns: 1fr; }
    }
</style>

<script>
  const btn = document.getElementById('form-submit-btn');
  if (btn) {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      btn.textContent = '¡Mensaje enviado!';
      (btn as HTMLButtonElement).style.background = '#1DB954';
      setTimeout(() => {
        btn.textContent = ' <i class="ph ph-paper-plane-tilt"></i> Enviar consulta';
        (btn as HTMLButtonElement).style.background = '';
        document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach(f => f.value = '');
      }, 3000);
    });
  }
</script>

</BaseLayout>
