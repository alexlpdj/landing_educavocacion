---
// Sin props - estado del carrito viene de localStorage
---

<div class="cart-overlay" id="cart-overlay"></div>

<aside class="cart-drawer" id="cart-drawer" aria-label="Carrito de compras" aria-hidden="true">
  <div class="cart-header">
    <h2 class="cart-title">Tu carrito</h2>
    <button class="cart-close" id="cart-close" aria-label="Cerrar carrito">
      <i class="ph ph-x"></i>
    </button>
  </div>

  <div class="cart-body" id="cart-body"></div>

  <div class="cart-footer" id="cart-footer"></div>
</aside>

<style is:global>
  .cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(19, 16, 59, 0.45);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    z-index: 998;
  }
  .cart-overlay.active { opacity: 1; pointer-events: auto; }

  .cart-drawer {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: min(400px, 100vw);
    background: #fff;
    box-shadow: -4px 0 32px rgba(19,16,59,.14);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 999;
  }
  .cart-drawer.active { transform: translateX(0); }

  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(19,16,59,.08);
    flex-shrink: 0;
  }
  .cart-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--navy);
    margin: 0;
  }
  .cart-close {
    width: 34px; height: 34px;
    border-radius: 50%;
    border: none;
    background: rgba(19,16,59,.07);
    color: var(--navy);
    font-size: 1rem;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s, transform 0.2s;
    flex-shrink: 0;
  }
  .cart-close:hover { background: rgba(19,16,59,.14); transform: rotate(90deg); }

  .cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cart-footer {
    padding: 16px 20px;
    border-top: 1px solid rgba(19,16,59,.08);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Item */
  .cart-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px;
    background: rgba(19,16,59,.03);
    border: 1px solid rgba(19,16,59,.06);
    border-radius: 12px;
  }
  .cart-item-icon {
    font-size: 1.6rem;
    color: var(--sky);
    flex-shrink: 0;
    width: 36px;
    text-align: center;
  }
  .cart-item-info { flex: 1; min-width: 0; }
  .cart-item-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    margin: 0 0 4px 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .cart-item-meta {
    font-size: 0.75rem;
    color: var(--gray);
    margin: 0;
  }
  .cart-item-price {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--blue);
    flex-shrink: 0;
    align-self: center;
  }
  .cart-item-remove {
    background: none;
    border: none;
    color: var(--gray);
    font-size: 1rem;
    cursor: pointer;
    flex-shrink: 0;
    padding: 4px;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
  }
  .cart-item-remove:hover { color: #ef4444; background: rgba(239,68,68,.08); }

  /* Empty state */
  .cart-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 24px;
    color: var(--gray);
    gap: 12px;
  }
  .cart-empty-icon { font-size: 3rem; opacity: 0.35; }
  .cart-empty-title { font-weight: 700; color: var(--navy); font-size: 1rem; margin: 0; }
  .cart-empty-sub { font-size: 0.88rem; margin: 0; line-height: 1.5; }

  /* Summary */
  .cart-summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
  }
  .cart-summary-row.total {
    font-size: 1rem;
    font-weight: 800;
    color: var(--navy);
    padding-top: 8px;
    border-top: 1px solid rgba(19,16,59,.1);
    margin-top: 2px;
  }
  .cart-summary-row.total span:last-child { color: var(--blue); }
  .cart-summary-row .label { color: var(--gray); }
  .cart-summary-row .value { font-weight: 600; color: var(--navy); }

  .cart-pack-tag {
    background: rgba(41,171,226,.1);
    color: var(--sky);
    border: 1px solid rgba(41,171,226,.2);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cart-checkout-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 20px;
    background: var(--blue);
    color: #fff;
    border: none;
    border-radius: 999px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .cart-checkout-btn:hover {
    background: #1a1a8f;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(36,36,186,.3);
  }
  .cart-continue-btn {
    background: transparent;
    border: 1.5px solid rgba(19,16,59,.15);
    border-radius: 999px;
    padding: 10px 20px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--navy);
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .cart-continue-btn:hover { border-color: var(--navy); }

  @media (max-width: 600px) {
    .cart-header { padding: 16px 16px; }
    .cart-body { padding: 12px; }
    .cart-footer { padding: 12px 16px; }
  }
</style>

<script>
  import { getItems, removeItem, getTotals } from '../lib/cart';

  const overlay = document.getElementById('cart-overlay')!;
  const drawer  = document.getElementById('cart-drawer')!;
  const closeBtn = document.getElementById('cart-close')!;
  const bodyEl  = document.getElementById('cart-body')!;
  const footerEl = document.getElementById('cart-footer')!;

  function renderCart() {
    const items  = getItems();
    const totals = getTotals();

    if (items.length === 0) {
      bodyEl.innerHTML = `
        <div class="cart-empty">
          <div class="cart-empty-icon"><i class="ph ph-shopping-cart"></i></div>
          <p class="cart-empty-title">Tu carrito está vacío</p>
          <p class="cart-empty-sub">Añade cursos para comenzar</p>
        </div>`;
      footerEl.innerHTML = `
        <a href="/cursos/" class="cart-checkout-btn" style="background:var(--sky);">
          <i class="ph ph-graduation-cap"></i> Ver catálogo de cursos
        </a>`;
      return;
    }

    // Renderizar items
    bodyEl.innerHTML = items.map(item => `
      <div class="cart-item">
        <div class="cart-item-icon"><i class="ph ${item.icon}"></i></div>
        <div class="cart-item-info">
          <p class="cart-item-name">${item.title}</p>
          <p class="cart-item-meta">${item.hours}h · ${item.ects} ECTS${item.packEligible ? ' · Pack 2×1' : ''}</p>
        </div>
        <span class="cart-item-price">${item.price} €</span>
        <button class="cart-item-remove" data-slug="${item.slug}" aria-label="Eliminar ${item.title}">
          <i class="ph ph-trash"></i>
        </button>
      </div>
    `).join('');

    // Eventos de eliminar
    bodyEl.querySelectorAll<HTMLButtonElement>('.cart-item-remove').forEach(btn => {
      btn.addEventListener('click', () => {
        removeItem(btn.dataset.slug!);
        renderCart();
      });
    });

    // Renderizar footer
    const packTag = totals.packApplied
      ? `<div class="cart-pack-tag">
          <i class="ph-fill ph-fire"></i>
          Pack 2×1 aplicado — Ahorras ${totals.discount} €
        </div>`
      : '';

    const packHint = !totals.packApplied && totals.packCount === 1
      ? `<p style="font-size:0.78rem;color:var(--sky);margin:0;text-align:center;">
          <i class="ph ph-info"></i> Añade otro curso elegible para Pack 2×1 y ahorrarás 24 €
        </p>`
      : '';

    footerEl.innerHTML = `
      <div class="cart-summary-row">
        <span class="label">Subtotal</span>
        <span class="value">${totals.subtotal} €</span>
      </div>
      ${totals.packApplied ? `
        <div class="cart-summary-row">
          <span class="label" style="color:var(--sky);">Descuento pack</span>
          <span class="value" style="color:var(--sky);">−${totals.discount} €</span>
        </div>` : ''}
      <div class="cart-summary-row total">
        <span>Total</span>
        <span>${totals.total} €</span>
      </div>
      ${packTag}
      ${packHint}
      <div class="cart-actions">
        <a href="/matricula/checkout/" class="cart-checkout-btn">
          <i class="ph ph-lock-simple"></i> Proceder al pago →
        </a>
        <button class="cart-continue-btn" id="cart-continue">Seguir añadiendo cursos</button>
      </div>
    `;

    document.getElementById('cart-continue')?.addEventListener('click', closeDrawer);
  }

  function openDrawer() {
    renderCart();
    overlay.classList.add('active');
    drawer.classList.add('active');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.classList.add('cart-drawer-open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    overlay.classList.remove('active');
    drawer.classList.remove('active');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('cart-drawer-open');
    document.body.style.overflow = '';
  }

  overlay.addEventListener('click', closeDrawer);
  closeBtn.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });
  window.addEventListener('cart:open', openDrawer);
  window.addEventListener('cart:updated', () => { if (drawer.classList.contains('active')) renderCart(); });
</script>
