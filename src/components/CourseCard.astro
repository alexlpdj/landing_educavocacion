---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AddToCartButton from './AddToCartButton.astro';

export interface Props {
  slug: string;
  title: string;
  description: string;
  hours: number;
  ects: number;
  price: number;
  icon: string;
  image?: ImageMetadata | string;
  packEligible?: boolean;
  animClass?: string;
  dataAttrs?: Record<string, string>;
}

const {
  slug, title, description, hours, ects, price, icon,
  image, packEligible, animClass = '', dataAttrs = {},
} = Astro.props;
---

<div class={`curso-card-modern ${animClass}`} {...dataAttrs}>
  <!-- Área clickable principal -->
  <a href={`/cursos/${slug}/`} class="curso-card-link" tabindex="-1" aria-hidden="true"></a>

  <div class="curso-card-top">
    {image && typeof image === 'object' ? (
      <Image
        src={image}
        alt={title}
        class="curso-card-img"
        widths={[400, 800]}
        sizes="(max-width: 600px) 100vw, 33vw"
      />
    ) : (
      <div class="curso-card-icon-wrap">
        <i class={`ph ${icon}`}></i>
      </div>
    )}
  </div>

  <div class="curso-card-body">
    <div class="curso-card-badges">
      <span class="badge badge--blue">{hours}h</span>
      <span class="badge badge--sky">{ects} ECTS</span>
      {packEligible && <span class="badge badge--green"><i class="ph-fill ph-fire"></i> Pack 2×1</span>}
    </div>

    <h3 class="curso-card-title">{title}</h3>
    <p class="curso-card-description">{description}</p>

    <div class="curso-card-spacer"></div>

    <div class="curso-card-price-section">
      <span class="curso-card-price">{price}€</span>
      <span class="curso-card-price-label">por curso</span>
    </div>

    <div class="curso-card-actions">
      <AddToCartButton
        slug={slug}
        title={title}
        price={price}
        hours={hours}
        ects={ects}
        packEligible={packEligible ?? false}
        icon={icon}
        size="sm"
      />
      <a href={`/cursos/${slug}/`} class="btn btn--outline-secondary btn--sm">Ver detalles</a>
    </div>
  </div>
</div>

<style>
  .curso-card-modern {
    background: var(--white);
    border: 1px solid rgba(19,16,59,.08);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all .3s cubic-bezier(.4,0,.2,1);
    position: relative;
  }

  .curso-card-modern:hover {
    border-color: rgba(41,171,226,.25);
    box-shadow: 0 12px 48px rgba(19,16,59,.15);
    transform: translateY(-4px);
  }

  .curso-card-link {
    position: absolute;
    inset: 0;
    bottom: auto;
    height: 180px;
    z-index: 1;
    cursor: pointer;
  }

  .curso-card-top {
    position: relative;
    overflow: hidden;
    height: 180px;
    flex-shrink: 0;
  }

  .curso-card-top::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 100% 0%, rgba(255,255,255,.15), transparent 70%);
    pointer-events: none;
    z-index: 2;
  }

  .curso-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s cubic-bezier(.4,0,.2,1);
  }

  .curso-card-modern:hover .curso-card-img {
    transform: scale(1.05);
  }

  .curso-card-icon-wrap {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    color: var(--white);
    background: linear-gradient(135deg, var(--blue), var(--sky));
  }

  .curso-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px;
    position: relative;
    z-index: 2;
  }

  .curso-card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .badge--blue {
    background: rgba(36,36,186,.1);
    color: var(--blue);
  }

  .badge--sky {
    background: rgba(41,171,226,.1);
    color: var(--sky);
  }

  .badge--green {
    background: rgba(16,185,129,.12);
    color: #059669;
  }

  .badge--green i {
    font-size: .6rem;
  }

  .curso-card-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--navy);
    margin: 0 0 8px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .curso-card-description {
    font-size: .82rem;
    color: var(--gray);
    line-height: 1.5;
    margin: 0 0 12px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .curso-card-spacer {
    flex: 1;
  }

  .curso-card-price-section {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 16px;
  }

  .curso-card-price {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--blue);
    line-height: 1;
  }

  .curso-card-price-label {
    font-size: .75rem;
    color: var(--gray);
    font-weight: 500;
  }

  .curso-card-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .curso-card-actions .atc-btn--sm {
    width: 100%;
    justify-content: center;
    order: -1;
  }

  .btn--outline-secondary {
    background: rgba(19,16,59,.04);
    color: var(--navy);
    border: 1px solid rgba(19,16,59,.15);
  }

  .btn--outline-secondary:hover {
    background: rgba(19,16,59,.08);
    border-color: rgba(19,16,59,.25);
    opacity: 1;
  }

  @media (max-width: 960px) {
    .curso-card-title { font-size: .95rem; }
    .curso-card-price { font-size: 1.4rem; }
  }

  @media (max-width: 600px) {
    .curso-card-body { padding: 16px; }
    .curso-card-title { font-size: .9rem; }
    .curso-card-description { font-size: .78rem; }
    .curso-card-price { font-size: 1.5rem; }
    .curso-card-actions {
      flex-direction: column;
      gap: 10px;
    }
    .curso-card-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
